@ARTICLE{Li20211,
	author = {Li, Xiaomei and Xie, Pinhua and Li, Ang and Xu, Jin and Ren, Hongmei and Ren, Bo and Li, Yanyu and Li, Jie},
	title = {Study of aerosol characteristics and sources using MAX-DOAS measurement during haze at an urban site in the Fenwei Plain},
	year = {2021},
	journal = {Journal of Environmental Sciences (China)},
	volume = {107},
	pages = {1 – 13},
	doi = {10.1016/j.jes.2020.12.015},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85100423535&doi=10.1016%2fj.jes.2020.12.015&partnerID=40&md5=9ce2c9490bd0a56db373caa7c703423c},
	abstract = {Atmospheric aerosols have effects on atmospheric radiation assessments, global climate change, local air quality and visibility. In particular, aerosols are more likely transformed and accumulated in winter. In this paper, we used the Multi-Axis Differential Optical Absorption Spectroscopy (MAX-DOAS) instrument to study the characteristics of aerosol type and contributions of PM2.5 chemical components to aerosol extinction (AE), vertical distribution of aerosols, and source. From December 30, 2018 to January 27, 2019, we conducted MAX-DOAS observations on Sanmenxia. The proportion of PM2.5 to PM10 was 69.48%–95.39%, indicating that the aerosol particles were mainly fine particles. By analyzing the ion data and modifying Interagency Monitoring of Protected Visual Environments (IMPROVE) method, we found that nitrate was the largest contributor to AE, accounting for 31.51%, 28.98%, and 27.95% of AE on heavily polluted, polluted, and clean days, respectively. NH4+, OC, and SO42− were also major contributors to AE. The near-surface aerosol extinction retrieved from MAX-DOAS measurement the PM2.5 and PM10 concentrations measured by an Unmanned Aerial Vehicle (UAV) have the same trend in vertical distribution. AE increased about 3 times from surface to 500 m. With the backward trajectory of the air mass during the haze, we also found that the continuous heavy pollution was mainly caused by transport of polluted air from the northeast, then followed by local industrial emissions and other sources of emissions under continuous and steady weather conditions. © 2020},
	author_keywords = {Aerosol extinction (AE); Aerosol optical depth (AOD); Haze; IMPROVE; MAX-DOAS; PM<sub>2.5</sub>},
	keywords = {Aerosols; Air Pollutants; Environmental Monitoring; Particulate Matter; Spectrum Analysis; Absorption spectroscopy; Air quality; Antennas; Atmospheric chemistry; Atmospheric radiation; Climate change; Industrial emissions; Light extinction; Radiation effects; Unmanned aerial vehicles (UAV); Urban growth; Aerosol characteristics; Backward trajectory; Chemical component; Differential optical absorption spectroscopy; Global climate changes; Interagency monitoring of protected visual environments; PM2.5 and PM10 concentrations; Vertical distributions; aerosol; air mass; chemical composition; haze; nitrate; optical depth; particulate matter; urban site; aerosol; air pollutant; environmental monitoring; particulate matter; spectroscopy; Atmospheric aerosols},
