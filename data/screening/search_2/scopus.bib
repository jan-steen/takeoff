	title = {Study of Temperature Heterogeneities at Sub-Kilometric Scales and Influence on Surface-Atmosphere Energy Interactions},
	year = {2019},
	journal = {IEEE Transactions on Geoscience and Remote Sensing},
	volume = {57},
