}

@ARTICLE{Strashok202258,
	author = {Strashok, Oleksandra and Kolesnichenko, Olena and Kalbarczyk, Robert and Ziemiańska, Monika and Bidolakh, Dmytro and Strashok, Vitalii},
	title = {Assessment of Model Grass Plots of the City of Kyiv in Eco-Conditions of Anthropogenic Load},
	year = {2022},
	journal = {Ukrainian Journal of Forest and Wood Science},
	volume = {13},
