	title = {Early Detection of Pipeline Natural Gas Leakage from Hyperspectral Imaging by Vegetation Indicators and Deep Neural Networks},
	year = {2024},
	journal = {Environmental Science and Technology},
	volume = {58},
	number = {27},
	pages = {12018 – 12027},
	doi = {10.1021/acs.est.4c03345},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85196393599&doi=10.1021%2facs.est.4c03345&partnerID=40&md5=1120bd35319d96243d4f120cf94d2734},
	abstract = {The timely detection of underground natural gas (NG) leaks in pipeline transmission systems presents a promising opportunity for reducing the potential greenhouse gas (GHG) emission. However, existing techniques face notable limitations for prompt detection. This study explores the utility of Vegetation Indicators (VIs) to reflect vegetation health deterioration, thereby representing leak-induced stress. Despite the acknowledged potential of VIs, their sensitivity and separability remain understudied. In this study, we employed ground vegetation as biosensors for detecting methane emissions from underground pipelines. Hyperspectral imaging from vegetation was collected weekly at both plant and leaf scales over two months to facilitate stress detection using VIs and Deep Neural Networks (DNNs). Our findings revealed that plant pigment-related VIs, modified chlorophyll absorption reflectance index (MCARI), exhibit commendable sensitivity but limited separability in discerning stressed grasses. A NG-specialized VI, the optimized soil-adjusted vegetation index (OSAVI), demonstrates higher sensitivity and separability in early detection of methane leaks. Notably, the OSAVI proved capable of discriminating vegetation stress 21 days after methane exposure initiation. DNNs identified the methane leaks following a 3-week methane treatment with an accuracy of 98.2%. DNN results indicated an increase in visible (VIS) and a decrease in near-infrared (NIR) in spectra due to methane exposure. © 2024 American Chemical Society.},
	author_keywords = {DNN; Greenhouse gas (GHG); hyperspectral imaging; machine learning; pipeline leak detection; remote sensing; vegetation indicators},
	keywords = {Environmental Monitoring; Hyperspectral Imaging; Methane; Natural Gas; Neural Networks, Computer; Deterioration; Greenhouse gases; Hyperspectral imaging; Infrared devices; Leak detection; Methane; Natural gas; Pipelines; Remote sensing; Vegetation mapping; chlorophyll; methane; methane; natural gas; Greenhouse gas; Greenhouses gas; Leaks detections; Machine-learning; Methane leaks; Pipeline leak detection; Pipeline leaks; Remote-sensing; Vegetation index; Vegetation indicator; early warning system; gas pipeline; greenhouse gas; leakage; machine learning; multispectral image; natural gas; remote sensing; sensor; vegetation index; absorption; Article; controlled study; deep neural network; hyperspectral imaging; methane emission; nonhuman; pipeline; plant; plant leaf; plant physiology; plant stress; time series analysis; unmanned aerial vehicle; vegetation; artificial neural network; environmental monitoring; hyperspectral imaging; procedures; Deep neural networks},
