@ARTICLE{Pi202039,
	author = {Pi, Weiqiang and Bi, Yuge and Du, Jianmin and Yang, Hongyan and Zhang, Xipeng and Kang, Yongchao},
	title = {Classification of grassland desertification in China based on vis-NIR UAV hyperspectral remote sensing},
	year = {2020},
