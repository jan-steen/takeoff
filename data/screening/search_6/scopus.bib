	keywords = {Antennas; Geological surveys; Global positioning system; Ground penetrating radar systems; Radar imaging; Radar measurement; Snow; Snow melting systems; Software radio; Stratigraphy; Tracking radar; Travel time; Ultra-wideband (UWB); Autonomous unmanned aerial vehicles; Field campaign; Frequency measurements; Sea measurements; Snow depths; Software defined radar; Software-defined radar; Synthetic wideband waveform; Unmanned aerial vehicle .; Wideband waveforms; radar; snow cover; software; unmanned vehicle; Unmanned aerial vehicles (UAV)},
