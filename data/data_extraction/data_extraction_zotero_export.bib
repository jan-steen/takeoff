@article{wang_artemisia_2024,
	title = {Artemisia {Frigida} {Distribution} {Mapping} in {Grassland} with {Unmanned} {Aerial} {Vehicle} {Imagery} and {Deep} {Learning}},
	volume = {8},
	copyright = {https://creativecommons.org/licenses/by/4.0/},
	issn = {2504-446X},
	url = {https://www.mdpi.com/2504-446X/8/4/151},
	doi = {10.3390/drones8040151},
	abstract = {Artemisia frigida, as an important indicator species of grassland degradation, holds significant guidance significance for understanding grassland degradation status and conducting grassland restoration. Therefore, conducting rapid surveys and monitoring it is crucial. In this study, to address the issue of insufficient identification accuracy due to the large density and small size of Artemisia frigida in UAV images, we improved the YOLOv7 object detection algorithm to enhance the performance of the YOLOv7 model in Artemisia frigida detection. We applied the improved model to the detection of Artemisia frigida across the entire experimental area, achieving spatial mapping of Artemisia frigida distribution. The results indicate: In comparison across different models, the improved YOLOv7 + Biformer + wise-iou model exhibited the most notable enhancement in precision metrics compared to the original YOLOv7, showing a 6\% increase. The mean average precision at intersection over union (IoU) threshold of 0.5 (mAP@.5) also increased by 3\%. In terms of inference speed, it ranked second among the four models, only trailing behind YOLOv7 + biformer. The YOLOv7 + biformer + wise-iou model achieved an overall detection precision of 96\% and a recall of 94\% across 10 plots. The model demonstrated superior overall detection performance. The enhanced YOLOv7 exhibited superior performance in Artemisia frigida detection, meeting the need for rapid mapping of Artemisia frigida distribution based on UAV images. This improvement is expected to contribute to enhancing the efficiency of UAV-based surveys and monitoring of grassland degradation. These findings emphasize the effectiveness of the improved YOLOv7 + Biformer + wise-iou model in enhancing precision metrics, overall detection performance, and its applicability to efficiently map the distribution of Artemisia frigida in UAV imagery for grassland degradation surveys and monitoring.},
	language = {en},
	number = {4},
	urldate = {2025-05-27},
	journal = {Drones},
	author = {Wang, Yongcai and Wan, Huawei and Hu, Zhuowei and Gao, Jixi and Sun, Chenxi and Yang, Bin},
	month = apr,
	year = {2024},
	pages = {151},
	file = {Volltext:files/12373/Wang et al. - 2024 - Artemisia Frigida Distribution Mapping in Grasslan.pdf:application/pdf},
}

@article{forsmoo_dronebased_2018,
	title = {Drone‐based structure‐from‐motion photogrammetry captures grassland sward height variability},
	volume = {55},
	issn = {0021-8901, 1365-2664},
	url = {https://besjournals.onlinelibrary.wiley.com/doi/10.1111/1365-2664.13148},
	doi = {10.1111/1365-2664.13148},
	abstract = {Abstract
            
              
                
                  Grasslands deliver a range of ecosystem services, including the provision of food and biodiversity, and regulation of soil carbon storage and hydrology. Monitoring schemes are needed to quantify spatial changes in these multiple functions alongside ecosystem degradation. Sward height is widely recognised as a key spatial variable in the provision of these services. Current manual monitoring approaches are labour intensive, and often fail to capture spatial patterns of important features, including sward height.
                
                
                  
                    Proximal sensing from small aerial drones carrying lightweight cameras can be transformed into surface height models using image‐based structure‐from‐motion and Multi‐View Stereo‐based approaches; this presents a new opportunity for monitoring the spatial structure of grassland sward height. We combined aerial photographs with field survey data and an open‐source image‐based modelling‐processing workflow to generate sward height measurements for a field comprising mainly
                    Lolium perenne
                    (perennial ryegrass) and
                    Trifolium pratense
                    (red clover). We compared the derived measurements with in situ data captured on the same day using traditional agronomic sward height techniques to determine the quality of the drone‐derived surface model product for sward characterisation.
                  
                
                
                  
                    The SfM and Multi‐View Stereo‐based surface model had a mean absolute sward height measurement error of between 3.7 and 4.2 cm. To produce field observations with equivalent quality would require up to 550 sward height measurements for the study site (area: 8,059 m
                    2
                    ), which is not feasible over larger extents required for conservation of key species or agronomic purposes.
                  
                
                
                  
                    Synthesis and applications
                    . We demonstrate how the collection of precise and detailed information on the spatial structure of grasslands can be made over management‐relevant extents. Aerial digital photographs can be transformed into surface models using an image‐based modelling approach: structure‐from‐motion and Multi‐View Stereo techniques. Image‐based measurements of sward heights were compared with manual sward height data captured on the same day. This novel source of vegetation spatial information could improve sward management for conservation and agronomy applications. The approach supports frequent surveys, at user‐controlled revisit times, and delivers data for spatial monitoring of key grassland functions and services.
                  
                
              
            
          , 
            Sammanfattning
            
              
                
                  Gräsmarker är värdefulla. De bidrar med en rad nyckelfunktioner och naturvärden så som kolinlagring, produktion av biomassa och biologisk mångfald. Nya mätmetoder är emellertid nödvändiga för att bättre förstå dessa funktioners och naturvärdens förändringar över tid och rum, samt för att tidigt kunna upptäcka potentiell ekosystemdegradering. Det är allmänt vedertaget att gräsets längd är en nyckelvariabel för försörjningen av viktiga ekosystemtjänster så som biodiversitet. Nuvarande manuella mätmetoder är tidskrävande, och missar ofta viktiga aspekter och dess trender, så som gräsets medellängd och dess rumsliga variation.
                
                
                  
                    Flygbilder från små luftburna drönare utrustade med kompakta kameror kan förvandlas till tredimensionella höjdmodeller genom fotogrammetrisk bearbetning av bilder. Detta innebär nya möjligheter för övervakningen av gräsets längd över tid och rum. Vi kombinerade flygfoton och fältdata med ett fotogrammetriskt bildbearbetningsförfarande för att mäta gräsets längd. Fältstudien genomfördes på gräsmark som främst bestod av
                    Lolium perenne
                    (engelskt rajgräs) och
                    Trifolium pratense
                    (rödklöver). De erhållna bildabaserade mätningarna av gräsets längd jämfördes med traditionella, manuella metoder för att mäta gräsets längd.
                  
                
                
                  
                    Gräsets uppmätta längd från den bildabaserade, tredimensionella höjdmodellen hade en genomsnittlig avvikelse på mellan 3.7 och 4.2 cm jämfört med manuellt insamlad referens‐data. Fältobservationer av likvärdig kvalitet skulle, med traditionella metoder, kräva uppemot 550 mätningar av gräsets längd för det beskrivna fältstudieområdet (area: 8059 m
                    2
                    ). Något som således inte är praktiskt genomförbart över större områden vilket bevarandet av nyckelarter samt lantbruksnäringen kräver.
                  
                
                
                  
                    Sammanställning och tillämpning
                    . Vi visar hur insamling av precis och detaljrik information om förändringar i en gräsmarks vegetation över tid och rum nu är möjlig över områden stora nog för att vara av relevans för relevanta intressenter. Digitala flygbilder kan genom fotogrammetriska bildbearbetningsmetoder förvandlas till digitala höjdmodeller. Genom att samla in data om gräsets längd med traditionella metoder samma dag som området flögs med en drönare kunde kvaliteten av den bildbaserade uppskattningen av gräsets längd approximeras. Denna nya, lovande källa till information om vegetationen och dess småskaliga karaktäristik kan bevara och/eller förstärka gräsmarkers naturvärden. Metoden främjar regelbunden kartläggning av vegetationens förändringar över tid och rum då insamlingen av data kan ske på användarens villkor ‐ och levererar en dataprodukt som kan bli ett viktigt stöd i arbetet för att nå uppsatta miljömål om till exempel biologisk mångfald i och utanför odlingslandskap.
                  
                
              
            
