@ARTICLE{Martin20242767,
	author = {Martin, Harrison K. and Edmonds, Douglas A. and Yanites, Brian J. and Niemi, Nathan A.},
	title = {Quantifying landscape change following catastrophic dam failures in Edenville and Sanford, Michigan, USA},
	year = {2024},
	journal = {Earth Surface Processes and Landforms},
	volume = {49},
	number = {9},
	pages = {2767 – 2778},
	doi = {10.1002/esp.5855},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85191695009&doi=10.1002%2fesp.5855&partnerID=40&md5=e40059c743dfa9462af0e5e67f40eb2e},
	abstract = {Dam failures due to changing hydroclimate and ageing infrastructure pose a significant threat to downstream river systems and communities. The detailed geomorphic effects of catastrophic dam failures are not well known because of a lack of high-resolution topographic data before and after failures. On 19 May 2020, the 17-m-tall Edenville and 11-m-tall Sanford dams near Midland, Michigan, USA, failed as a result of significant rainfall over the preceding 2 days. We analysed the geomorphic impacts of these failures using a pre-failure airborne lidar dataset and three uncrewed aerial vehicle (UAV)-based lidar surveys collected 2 weeks, 3 months and 11 months after failure. Our survey following the dam failure revealed 47 100 ± 11 900 m3 of net floodplain erosion and 17 300 ± 4200 m3 of net deposition downstream of the Edenville and Sanford dam breaches, respectively. Over the year following failure, most geomorphic change was confined to new knickpoints migrating slowly through underlying glacial till substrate, with little change to riverbanks or surrounding floodplains. A lack of impounded reservoir sediment and antecedent downstream topography, including valley width and the location of the breaches relative to the river below the dams, contributed to relatively modest geomorphic changes despite the magnitude of water released. We provide insight into how landscapes are shaped by catastrophic floods, which are likely to become more common with ageing dams and a changing hydroclimate. © 2024 The Authors. Earth Surface Processes and Landforms published by John Wiley & Sons Ltd.},
	author_keywords = {dam failure; landscape change; outburst floods; repeat lidar; river flooding},
	keywords = {Michigan; United States; Antennas; Dams; Disasters; Floods; Optical radar; Reservoirs (water); Rivers; Topography; Unmanned aerial vehicles (UAV); Water levels; Dam failure; Down-stream; Earth surface process; Flood plains; Hydroclimates; Landscape changes; Michigan; Outburst floods; Repeat lidar; River flooding; aerial survey; catastrophic event; dam failure; flooding; geomorphological response; hydrometeorology; landscape change; lidar; precipitation intensity; quantitative analysis; rainfall; river engineering; river flow; structural analysis; structural response; topographic effect; Failure (mechanical)},
