@ARTICLE{7,
date_generated={JAN},
language={English},
author={Hajdukiewicz, H. and Zielonka, A. and Hajdukiewicz, M. and Walusiak, E.},
address={Polish Acad Sci, Inst Nat Conservat, Al Mickiewicza 33, PL-31120 Krakow, Poland and Kielce Univ Technol, Dept Environm Engn Geomat & Energet, Al Tysiaclecia Panstwa Polskiego 7, PL-25314 Kielce, Poland},
year={2026},
title={UAV-based fine-scale monitoring reveals species-specific riparian responses to environmental changes},
source={ECOLOGICAL INDICATORS},
proceedings_title={Polish Academy of Sciences and Kielce University of Technology},
volume={182},
article_number={114573},
abstract={Riparian forests, although covering less than 1 % of Europe's land area, play a crucial role in maintaining biodiversity and providing key ecosystem services such as bank stabilization, nutrient retention, and stream temperature regulation. Despite their importance, many floodplains remain degraded due to historical land-use change, hydrological regulation, urbanization, biological invasions, and climate change. Reliable, spatially explicit indicators are needed to assess riparian vegetation condition and support adaptive management. This study introduces an integrated approach that combines high-resolution unmanned aerial vehicle (UAV) multispectral imagery with meteorological data, offering one of the first detailed assessments of seasonal riparian vegetation dynamics in Central Europe. Four UAV surveys (May–September 2022) conducted along the Silnica River in central Poland were used to derive NDVI, NDRE, and MTCI indices, which were related to topographic wetness and LiDAR-derived canopy metrics. Results revealed distinct functional differences among vegetation groups. NDVI effectively captured biomass accumulation, NDRE reflected longer-term physiological responses, and MTCI was most sensitive to post-drought chlorophyll recovery. Invasive species showed consistently high NDVI but lower NDRE and MTCI, indicating structural robustness but lower physiological efficiency. Unlike medium-resolution satellite imagery, where heterogeneous canopies produce mixed spectral signals and spatial averaging that mask functional variability, UAV-based monitoring captures these dynamics at ecologically meaningful scales. The integration of spectral and meteorological information demonstrates the potential of UAV platforms to generate fine-scale, repeatable indicators for early stress detection, invasive species monitoring, and adaptive management of riparian ecosystems under changing climate conditions. © © 2025. Published by Elsevier Ltd.},
