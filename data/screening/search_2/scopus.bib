@ARTICLE{Lu2025,
	author = {Lu, Ziyan and Zhong, Tongxin and Qiao, Yue and Wu, Guiyi and Xu, Haishun},
	title = {Enhancing Microclimate Sustainability: The Impact of Blue–Green–Gray Underlying Surfaces in Stormwater Parks Under Subtropical Monsoon Climates},
	year = {2025},
	journal = {Sustainability (Switzerland)},
	volume = {17},
