@ARTICLE{Česnulevičius2019,
	author = {Česnulevičius, Algimantas and Bautrėnas, Artūras and Bevainis, Linas and Ovodas, Donatas},
	title = {A comparison of the influence of vegetation cover on the precision of an UAV 3D model and ground measurement data for archaeological investigations: A case study of the lepelionys mound, Middle Lithuania},
