@ARTICLE{Vlasenko2020343,
	author = {Vlasenko, Inna and Starodubtsev, Volodymyr},
	title = {SOIL COVER SPATIAL HETEROGENEITY IN AGRICULTURAL FIELDS OF FOREST-STEPPE ZONE},
	year = {2020},
	journal = {International Journal of Ecosystems and Ecology Science},
	volume = {10},
