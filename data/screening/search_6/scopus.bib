	author = {Vega-Puga, Masuly and Romo-Leon, José Raúl and Castellanos, Alejandro E. and Castillo-Gámez, Reyna A. and Garatuza-Payán, Jaime and Ángeles-Pérez, Gregorio},
	title = {High resolution images for change detection on aboveground carbon storage in semiarid communities, after the introduction of exotic species Cenchrus ciliaris; [Uso de imágenes aéreas de alta resolución para la detección de cambios en el almacén de carbono en biomasa aérea en comunidades semiáridas, tras la introducción de la especie exótica Cenchrus ciliaris]},
	year = {2023},
