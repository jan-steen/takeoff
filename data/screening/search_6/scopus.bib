@ARTICLE{Silva20143038,
	author = {Silva, Brenner and Lehnert, Lukas and Roos, Kristin and Fries, Andreas and Rollenbeck, Rutger and Beck, Erwin and Bendix, Jorg},
	title = {Mapping two competing grassland species from a low-altitude helium balloon},
