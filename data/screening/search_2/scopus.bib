	title = {Identification of reproduction sites of Aedes aegypti with remote pilot aircraft (ARP); [Identificação de sítios de reprodução de Aedes aegypti com aeronave remotamente pilotada (ARP)]},
	year = {2021},
	journal = {Nativa},
