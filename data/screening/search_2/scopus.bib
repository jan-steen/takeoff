}

@ARTICLE{Clint Slatton2008559,
	author = {Clint Slatton, K. and Crawford, Melba M. and Chang, Li-Der},
	title = {Modeling temporal variations in multipolarized radar scattering from intertidal coastal wetlands},
	year = {2008},
	journal = {ISPRS Journal of Photogrammetry and Remote Sensing},
	volume = {63},
	number = {5},
	pages = {559 – 577},
	doi = {10.1016/j.isprsjprs.2008.07.003},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-51249114747&doi=10.1016%2fj.isprsjprs.2008.07.003&partnerID=40&md5=ccd3817a1af2c93827273ddc503b31f0},
	abstract = {Coastal wetlands form critical ecosystems that are very sensitive to natural and anthropogenic environmental factors. These dynamic environments can exhibit both seasonal and year-to-year variability causing significant temporal variations in remotely sensed data. Understanding these variations is necessary if time series of remotely sensed data are to be used to monitor and manage coastal environments. Coastal areas can also experience persistent cloud cover, thereby making the use of microwave sensors, such as radar, potentially attractive for monitoring. Data acquired by polarimetric Synthetic Aperture Radar (SAR) and Laser Altimeter (LIDAR) sensors are analyzed to evaluate the response of a coastal marsh complex to climatic and tidal processes. The utility of L-band SAR data is investigated for detecting the presence of inundation and quantifying seasonal variations in plant phenology in several wetland environments. A coherent microwave scattering model is used to simulate radar backscatter from the marsh under different phenological and inundation conditions. Coastal marshes can exhibit scattering behavior that is different from other environments, such as forests and inland grasslands, for which scattering phenomena have been more thoroughly studied. Using a high-resolution Digital Elevation Model (DEM) derived from LIDAR data and ancillary measurements of climatic and tidal conditions, changes in the multi-polarization L-band SAR responses over a three-year period are related to specific scattering mechanisms in the marsh. Results indicate that variations in polarization preference of herbaceous marshes are often more pronounced than those observed over upland areas. Succulent halophytic plants in the high marsh respond strongly to inundation but only mildly to climatic factors, such as average daily temperature. Conversely, the response of non-succulent halophytic plants in the low marsh is strongly dependent on climate, which in turn affects their response to inundation. Results indicate that some knowledge of the vegetation phenology is required, along with scattering simulations, for meaningful interpretation of multi-temporal SAR data over coastal wetlands. © 2008 International Society for Photogrammetry and Remote Sensing, Inc. (ISPRS).},
	author_keywords = {Change detection; Coast; LIDAR; Polarization; SAR},
	keywords = {Chlorine Compounds; Data Processing; Ecosystems; Forests; Mathematical Models; Polarization; Radar; Satellites; Scattering; Sensors; Temperature; Time Series Analysis; Wetlands; Aneroid altimeters; Chlorine compounds; Coastal zones; Electromagnetic waves; Forestry; Geodetic satellites; Geomorphology; Imaging systems; Knowledge based systems; Microwaves; Optical radar; Polarization; Radar; Radio; Sensors; Surveying; Synthetic aperture radar; Synthetic apertures; Target drones; Time series analysis; altimeter; climate change; cloud cover; coastal wetland; coastal zone; data acquisition; digital elevation model; environmental factor; halophyte; human activity; intertidal environment; lidar; marsh; microwave imagery; numerical model; phenology; polarization; radar altimetry; remote sensing; seasonal variation; synthetic aperture radar; Change detection; Coast; Coastal wetlands; LIDAR; SAR; Wetlands},
	type = {Article},
	publication_stage = {Final},
