@ARTICLE{Ye2025,
	author = {Ye, Wenbin and Xu, Hongsheng and Zhou, Yifan and Chu, Fukai and Song, Lei and Hu, Yuan and Hu, Weizhao},
	title = {Development of eco-benign firebreaks based on flame-retardant ammonium polyphosphate hybrid system},
	year = {2025},
	journal = {Sustainable Materials and Technologies},
	volume = {43},
	doi = {10.1016/j.susmat.2024.e01208},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85211699198&doi=10.1016%2fj.susmat.2024.e01208&partnerID=40&md5=13792086626c2e7c8d54050420013d12},
	abstract = {The increasing frequency of wildfires globally because of climate changing has resulted in significant casualties and substantial property losses for humanity. Due to the difficulty of extinguishing wildfires, establishing firebreaks in advance is a critical approach to impeding their rapid spread. However, conventional firebreaks such as setting non-vegetation regions or biologically fire prevention forests affect the natural evolution of vegetation, which is not conformed to the requirements of sustainable development. In this study, an eco-friendly fire retardant was developed for forest grassland firebreaks, which can be rapidly implemented by drones and without affecting vegetation growth. The rapid carbonization of polyhydroxyl compounds in vegetation was catalyzed by the abundant acidic sites in fire retardant. Therefore, total heat release and total smoke production were reduced by 30 % and 18.7 % respectively. In addition, establishing a fire spread model based on the Wildland-urban interface Fire Dynamics Simulator (WFDS) to validate the fire prevention effect of firebreaks. This work is aiming to serve as a fundamental basis for designing large-scale forest grassland fire prevention and firebreaks. © 2024},
	author_keywords = {Ammonium polyphosphate; Fire spread; Firebreak; Stimulation},
	keywords = {Abiotic; Anthropogenic; Fire extinguishers; Fireproofing; Vegetation; Ammonium polyphosphates; Critical approach; Eco benign; Eco-friendly; Fire prevention; Fire spread; Firebreak; Natural evolution; Property loss; Stimulation; Premixed flames},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 6}
}

@ARTICLE{Cvijanović202561,
	author = {Cvijanović, Dušanka and Novković, Maja and Milošević, Djuradj and Piperac, Milica Stojković and Galambos, Laszlo and Čerba, Dubravka and Stamenković, Olivera and Damnjanović, Bojan and Mesaroš, Minučer and Pavić, Dragoslav and Simić, Vladica and Trbojević, Ivana and Anđelković, Ana and Drešković, Nusret and Stammel, Barbara and Cyffka, Bernd and Radulović, Snežana},
	title = {Conservation and ecological screening of small water bodies in temperate riverine wetlands using UAV Photogrammetry (Middle Danube)},
	year = {2025},
	journal = {Nature Conservation},
	volume = {58},
	pages = {61 – 82},
	doi = {10.3897/natureconservation.58.116663},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85217900273&doi=10.3897%2fnatureconservation.58.116663&partnerID=40&md5=36d665875b4ed213dcb6b531fba15ae1},
	abstract = {Aquaticecosystemsinriverinewetlandsareimportantrefugesandnurseriesforfreshwater biota. Given the significant global loss and degradation of wetlands, regular conservation assessments of these habitats, even in not easily accessible regions, are crucial for implementing effective management. Thus, developing cost-effective approaches for rapid ecological and conservation screening of water bodies in floodplains, such as the Danube, is a priority. One potential solution is the use of UAV-based (Unmanned Aerial Vehicle) ecological indicators to complement existing monitoring frameworks. This paper aims to explore whether UAV-based macrophyte data can provide a more precise indication of the trophic state and conservation indices (assessed through fish and macroinvertebrate communities) of temperate wetland lentic ecosystems, compared to traditional field surveys. The fieldwork was conducted during the summer months of 2019 at 23 sampling sites within eight lentic water bodies located in three wetland areas along the Middle Danube in Serbia. Data on aquatic vegetation, fish, and macroinvertebrate communities, and samples for water quality analysis were collected simultaneously. UAV images were acquired using an RGB camera. Orthomosaics were processed using supervised object-based image (OBIA) classification to obtain a single vector layer with macrophyte functional groups and taxa. Macrophyte cover metrics obtained during the fieldwork and UAV data processing were correlated against water quality parameters and conservation indices calculated for fish and macroinvertebrate assemblages. The study demonstrated that UAV photogrammetry can provide relatively precise measurements of macrophyte cover characteristics compared to traditional plot-based monitoring methods, making it effective for assessing aquatic ecosystems. The analysis revealed that sites with high values of fish and macroinvertebrate conservation indices, optimal oxygen conditions, and mesotrophic states were associated with UAV orthomosaic polygons showing relatively high macrophyte functional diversity and a presence of floating-rooted species. Conversely, sites experiencing eutrophication and a poor oxygen regime with species-poor fish assemblages correlated positively with a higher cover of amphibian and free-floating vegetation, as well as filamentous algae. In conclusion, UAV photogrammetry offers a cost-effective method to monitor aquatic habitats along large river floodplains, including those that are not easily accessible. © Dušanka Cvijanović et al.},
	author_keywords = {Aquatic vegetation; fish; macroinvertebrates; ponds; riverine wetlands; UAV indicators},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access, Gold Open Access}
}

