	keywords = {Aerial photography; Antennas; Biomass; Digital cameras; Fixed wings; Mean square error; Optical radar; Triangulation; Unmanned aerial vehicles (UAV); Video cameras; Aboveground biomass; Aerial triangulation; Allometric equations; Canopy Height Models; Oblique photograph; Point cloud; Subalpine coniferous forests; Forestry},
