}

@ARTICLE{Bendig20151,
	author = {Bendig, Juliane and Willkomm, Maximilian and Tilly, Nora and Gnyp, Martin Leon and Bennertz, Simon and Lenz-Wiedemann, Victoria I. S. and Bareth, Georg and Miao, Yuxin and Cao, Qiang},
	title = {Very high resolution Crop Surface Models (CSM) from UAV-based stereo images for rice growth monitoring in Northeast China},
	year = {2015},
