@ARTICLE{53,
date_generated={OCT},
language={English},
author={Thomson, A. and Hasan, M.F. and Berkhout, M. and Jacobs, J. and Morse-McNabb, E.},
address={Agr Victoria Res, Ellinbank SmartFarm, 1301 Hazeldean Rd, Ellinbank, Vic 3821, Australia and La Trobe Univ Agribio, Agr Victoria Res, 5 Ring Rd, Bundoora, Vic 3083, Australia and Univ Melbourne, Sch Agr Food & Ecosyst Sci, Parkville, Vic 3010, Australia},
