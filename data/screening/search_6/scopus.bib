}

@ARTICLE{Iñamagua-Uyaguari2022,
	author = {Iñamagua-Uyaguari, Juan Pablo and Green, David R. and Fitton, Nuala and Sangoluisa, Pamela and Torres, Jonathan and Smith, Pete},
	title = {Use of Unoccupied Aerial Systems to Characterize Woody Vegetation across Silvopastoral Systems in Ecuador},
	year = {2022},
	journal = {Remote Sensing},
	volume = {14},
	number = {14},
	doi = {10.3390/rs14143386},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85137260847&doi=10.3390%2frs14143386&partnerID=40&md5=aaa0c287aba22be8337c2275b0d3825e},
	abstract = {The trees in pastures are recognized for the benefits they provide to livestock, farmers, and the environment; nevertheless, their study has been restricted to small areas, making it difficult to upscale this information to national levels. For tropical developing countries, it is particularly important to understand the contribution of these systems to national carbon budgets. However, the costs associated with performing field measurements might limit the acquisition of this information. The use of unoccupied aerial systems (UAS) for ecological surveys has proved useful for collecting information at larger scales and with significantly lower costs. This study proposes a methodology that integrates field and UAS surveys to study trees on pasture areas across different terrain conditions. Our overall objective was to test the suitability of UAS surveys to the estimation of aboveground biomass (AGB), relying mainly on open-source software. The tree heights and crown diameters were measured on 0.1-hectare circular plots installed on pasture areas on livestock farms in the Amazon and Coastal regions in Ecuador. An UAS survey was performed on 1-hectare plots containing the circular plots. Field measurements were compared against canopy-height model values and biomass estimates using the two sources of information. Our results demonstrate that UAS surveys can be useful for identifying tree spatial arrangements and provide good estimates of tree height (RMSE values ranged from 0.01 to 3.53 m), crown diameter (RMSE values ranged from 0.04 to 4.47 m), and tree density (density differences ranging from 21.5 to 64.3%), which have a direct impact on biomass estimates. The differences in biomass estimates between the UAS and the field-measured values ranged from 25 to 75%, depending on site characteristics, such as slope and tree coverage. The results suggest that UASs are reliable and feasible tools with which to study tree characteristics on pastures, covering larger areas than field methods only. © 2022 by the authors.},
	author_keywords = {livestock landscapes; photogrammetry; silvopastoral},
	keywords = {Antennas; Budget control; Developing countries; Forestry; Information use; Open source software; Open systems; Software testing; Surveys; Unmanned aerial vehicles (UAV); Aerial systems; Crown diameter; Ecuador; Field measurement; Livestock landscape; Silvopastoral; Silvopastoral systems; System survey; Tree height; Woody vegetation; Biomass},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2; All Open Access, Gold Open Access, Green Open Access}
}@ARTICLE{Zhao2021,
	author = {Zhao, Yujin and Sun, Yihan and Chen, Wenhe and Zhao, Yanping and Liu, Xiaoliang and Bai, Yongfei},
	title = {The potential of mapping grassland plant diversity with the links among spectral diversity, functional trait diversity, and species diversity},
	year = {2021},
	journal = {Remote Sensing},
	volume = {13},
	number = {15},
	doi = {10.3390/rs13153034},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85112037063&doi=10.3390%2frs13153034&partnerID=40&md5=10cae4c9db164b9e7c2dab17182d0f89},
	abstract = {Mapping biodiversity is essential for assessing conservation and ecosystem services in global terrestrial ecosystems. Compared with remotely sensed mapping of forest biodiversity, that of grassland plant diversity has been less studied, because of the small size of individual grass species and the inherent difficulty in identifying these species. The technological advances in unmanned aerial vehicle (UAV)-based or proximal imaging spectroscopy with high spatial resolution provide new approaches for mapping and assessing grassland plant diversity based on spectral diversity and functional trait diversity. However, relatively few studies have explored the relationships among spectral diversity, remote-sensing-estimated functional trait diversity, and species diversity in grassland ecosystems. In this study, we examined the links among spectral diversity, functional trait diversity, and species diversity in a semi-arid grassland monoculture experimental site. The results showed that (1) different grassland plant species harbored different functional traits or trait combinations (functional trait diversity), leading to different spectral patterns (spectral diversity). (2) The spectral diversity of grassland plant species increased gradually from the visible (VIR, 400–700 nm) to the near-infrared (NIR, 700–1100 nm) region, and to the short-wave infrared (SWIR, 1100–2400 nm) region. (3) As the species richness increased, the functional traits and spectral diversity increased in a nonlinear manner, finally tending to saturate. (4) Grassland plant species diversity could be accurately predicted using hyperspectral data (R2 = 0.73, p < 0.001) and remotely sensed functional traits (R2 = 0.66, p < 0.001) using cluster algorithms. This will enhance our understanding of the effect of biodiversity on ecosystem functions and support regional grassland biodiversity conservation. © 2021 by the authors. Licensee MDPI, Basel, Switzerland.},
	author_keywords = {Biodiversity; Functional trait; Grassland; Imaging spectroscopy; Remote sensing; Spectral diversity},
	keywords = {Antennas; Biodiversity; Conservation; Ecosystems; Forestry; Infrared devices; Infrared radiation; Remote sensing; Unmanned aerial vehicles (UAV); Biodiversity conservation; Grassland ecosystems; High spatial resolution; Imaging spectroscopy; Plant species diversity; Semi-arid grasslands; Technological advances; Terrestrial ecosystems; Photomapping},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 27; All Open Access, Gold Open Access}
}

@ARTICLE{Weis2022391,
	author = {Weis, Maíra Guarlot and da Silva, Normandes Matos and Pessi, Dhonatan Diego and Barbosa, Domingos Sávio and Moreira, Rodrigo Martins and Luiz, Roberto Bueno and Paranhos Filho, Antonio Conceição},
	title = {Identification of erosion processes through hydrological models and high resolution aerial images; [Identificação de processos erosivos através de modelos hidrológicos e imagens aéreas de alta resolução]},
	year = {2022},
	journal = {Nativa},
