@ARTICLE{Pavlowsky2023,
	author = {Pavlowsky, R.T. and Hess, J.W. and Martin, D.J. and Dogwiler, T. and Bendix, J.},
	title = {Large wood loads in channels and on floodplains after a 500-year flood using UAV imagery in Mark Twain National Forest, Ozark Highlands, Missouri},
	year = {2023},
