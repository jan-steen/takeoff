@ARTICLE{Nahirnick201930,
	author = {Nahirnick, Natasha K. and Costa, Maycira and Schroeder, Sarah and Sharma, Tara},
	title = {Long-Term Eelgrass Habitat Change and Associated Human Impacts on the West Coast of Canada},
