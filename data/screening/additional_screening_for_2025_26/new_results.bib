@ARTICLE{80,
date_generated={NOV},
language={English},
author={Chieffallo, L. and Torresani, M. and Zannini, P. and de Vries, J.P.R. and Blaha, M. and Monacchia, A. and Kleijn, D. and Rocchini, D.},
address={Univ Bologna, Dept Biol Geol & Environm Sci, BIOME Lab, Alma Mater Studiorum, Via Irnerio 42, I-40126 Bologna, Italy and Free Univ Bolzano Bozen, Fac Agr Environm & Food Sci, Piazza Univ Univ Pl 1, Bolzano, Italy and Czech Univ Life Sci Prague, Fac Environm Sci, Dept Spatial Sci, Kamycka 129, Prague 16500, Czech Republic and Univ Trento, Ctr Agr Food Environm, San Michele All Adige, Italy and Fdn Edmund Mach, Res & Innovat Ctr, San Michele All Adige, Italy and Wageningen Univ, Plant Ecol & Nat Conservat Grp, Droevendaalsesteeg 3a, NL-6708 PB Wageningen, Netherlands},
year={2025},
title={Machine learning for biodiversity: UAV-based flower detection as an indirect proxy for bee abundance},
source={ECOLOGICAL INFORMATICS},
proceedings_title={University of Bologna and Free University of Bozen-Bolzano and Czech University of Life Sciences Prague and University of Trento and Fondazione Edmund Mach and Wageningen University & Research},
volume={91},
article_number={103346},
abstract={Pollination plays a crucial role in supporting agriculture and ecosystem functioning, making it an essential ecosystem service provided by bees and other insects. However, bee populations are increasingly threatened by habitat fragmentation, intensive agriculture, and climate change, among other threats. Improved monitoring of critical habitat factors, such as flower cover, is crucial to restore pollinator populations. Traditional approaches, such as field analyses, are often time-consuming and expensive, prompting the adoption of alternative methods to achieve greater efficiency and cost-effectiveness. Here, we introduce a novel approach that incorporates machine learning algorithms and optical images obtained from an unoccupied aerial vehicle (UAV). Using machine learning methods on RGB UAV imagery enabled us to estimate flower cover in UAV-monitored areas and make numerical inferences of wild bee pollinator abundance from those estimates. Unlike our previous study, which relied on separate machine learning models for each study area, our new method develops a single model that can automatically and efficiently recognize flower cover in various grassland ecosystems to successively estimate bee abundance and diversity. In addiction to this main objective, we also sought to determine which machine learning model would perform this important task best. The machine learning models used, particularly the Gradient Boost Machine (GBM), highlighted the capability of UAV RGB images combined with artificial intelligence to predict flower cover over time, which was highly correlated with bee abundance and diversity. This development represents an additional starting point for the use of machine learning and deep learning techniques in biodiversity studies within AES systems. © 2025 The Authors},
keywords={Applied ecology; Bees; Machine learning; Remote sensing; UAV; artificial intelligence; bee; biodiversity; ecosystem service; grassland; machine learning; pollinator; relative abundance; remote sensing; unmanned vehicle},
