	author = {Cocchi, Luca and Muccini, Filippo and Locritani, Marina and Spinelli, Leonardo and Cocco, Michele},
	title = {CORAL—Catamaran for Underwater Exploration: Development of a Multipurpose Unmanned Surface Vessel for Environmental Studies},
	year = {2024},
	journal = {Sensors},
