@ARTICLE{Shiels2025,
	author = {Shiels, Aaron B. and Beckerman, Scott F. and Blackwell, Bradley F.},
	title = {Choosing the best small-mammal survey method to maximize efficiency and accurately inform wildlife hazard management at airports},
	year = {2025},
	journal = {Wildlife Society Bulletin},
	volume = {49},
	number = {1},
	doi = {10.1002/wsb.1572},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-86000435849&doi=10.1002%2fwsb.1572&partnerID=40&md5=13c5c189479c43a69142d531cd293f06},
	abstract = {Small mammals compose a prey base for larger predators, species that pose animal-aircraft collision risk (strike risk). Surveys of small mammals at airports inform species relative abundance estimates, information used by airport biologists to direct management to reduce strike risk. New survey technologies present an opportunity to evaluate best-management-practices for small-mammal survey methods. Our objectives were to 1) describe the airport environment and reasoning for conducting small-mammal population estimates, 2) review goals for small-mammal surveys at airports, 3) conduct a formal literature review of small-mammal survey methods at airports, 4) compare/contrast survey types and designs, and 5) identify the most promising survey method(s). A desired survey method provides a relative (not absolute) abundance estimate, is accurate, labor- and cost-efficient, repeatable, and poses little hazard to airport operations. For each survey method, we provided the advantages and disadvantages, common biases, units of measurement, time from data collection to relative abundance indices, equipment costs, and labor costs. Eight small-mammal survey methods were assessed for use in airport settings, including snap-traps, live-traps, active burrows, trail cameras, tracking tunnels, chew blocks/cards, thermal optics, and Uncrewed Aircraft Systems (UAS). We identified snap-traps and tracking tunnels as the 2 most promising methods for most airports, considering the breadth of applications across land covers and climate, and given their low equipment costs, moderate labor costs, and short time from deployment to calculating a relative abundance estimate (e.g., individuals per trap or tunnel nights). Although newer surveying technologies are available, they are weaker candidates because of reduced detections in dense grass (thermal optics, trail cameras), extensive image processing times (e.g., trail cameras, UAS), and challenges with permit acquisition (e.g., UAS). Methods should be revisited periodically as alternative methods/technologies could offer advances via automation with equal or enhanced accuracy. Airport wildlife biologists and managers should consider the various options we describe when choosing appropriate small-mammal survey methods that capitalize on accuracy, efficiency, and safety. Published 2025. This article is a U.S. Government work and is in the public domain in the USA. Wildlife Society Bulletin published by Wiley Periodicals LLC on behalf of The Wildlife Society.},
	author_keywords = {animal-aircraft strike hazards/risk; detection methods; grass-dominant habitats; lethal and nonlethal capture; predator-prey interactions; rodents},
	keywords = {abundance estimation; accuracy assessment; airport; detection method; grass; image processing; nature-society relations; predator-prey interaction; rodent; tracking; wildlife management},
	type = {Article},
	publication_stage = {Final},
