@ARTICLE{Gallmann2022,
	author = {Gallmann, Johannes and Schüpbach, Beatrice and Jacot, Katja and Albrecht, Matthias and Winizki, Jonas and Kirchgessner, Norbert and Aasen, Helge},
	title = {Flower Mapping in Grasslands With Drones and Deep Learning},
	year = {2022},
	journal = {Frontiers in Plant Science},
	volume = {12},
