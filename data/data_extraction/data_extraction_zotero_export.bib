	doi = {10.1111/grs.12415},
	abstract = {Abstract
            
              Accurate determination of the weed ratio in artificial meadows is critical for efficient pasture renovation. Reed canary grass (
              
                Phalaris arundinacea
              
              L., RCG) is treated as a troublesome grass in the Hokkaido region of Japan because of its low feed quality and poor palatability in dairy farming. In the present study, we examined a method of identifying the dominant area of RCG in timothy (
              Phleum pretense
