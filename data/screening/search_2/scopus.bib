	note = {Cited by: 17; All Open Access, Gold Open Access}
}

@ARTICLE{Beene20211346,
	author = {Beene, Daniel and Zhang, Su and Paulus, Gernot},
	title = {Workflow for hydrologic modelling with sUAS-acquired aerial imagery},
	year = {2021},
	journal = {Geocarto International},
	volume = {36},
