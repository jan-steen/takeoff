@ARTICLE{Zhang2021,
	author = {Zhang, Junzhe and Okin, Gregory S. and Zhou, Bo and Karl, Jason W.},
	title = {UAV-derived imagery for vegetation structure estimation in rangelands: validation and application},
	year = {2021},
	journal = {Ecosphere},
	volume = {12},
