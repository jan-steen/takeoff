	title = {Application of UAV RGB Image in Monitoring and Coverage Estimation of Stellera chamaejasme Invasion in Alpine Grasslands, Qinghai-Tibet Plateau; [无人机RGB影像在高寒草地狼毒入侵监测及盖度估算中的应用]},
	year = {2023},
	journal = {Chinese Journal of Grassland},
	volume = {45},
