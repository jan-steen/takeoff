}

@ARTICLE{Liao20214,
	author = {Liao, Xiaohan and Shi, Chunxiang and Wang, Bing},
	title = {Construction of comprehensive observation system of natural resource elements based on UAV remote sensing, data fusion and ecological value; [从无人机遥感'数据融合'生态价值谈自然资源要素综合观测体系构建]},
	year = {2021},
	journal = {Geological Survey of China},
