@ARTICLE{Wanjie2023169,
	author = {Wanjie, Liang and Jing, Cao and Chuanliang, Sun and Hongxin, Cao and Wenyu, Zhang},
	title = {Research and development of crop diseases intelligent recognition system based on deep learning; [基于深度学习的农作物病害识别系统研发]},
	year = {2023},
	journal = {Journal of Chinese Agricultural Mechanization},
