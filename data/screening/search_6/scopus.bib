@ARTICLE{Wang2023,
	author = {Wang, Shengli and Bi, Yuge and Du, Jianmin and Zhang, Tao and Gao, Xinchao and Jin, Erdmt},
	title = {The Unmanned Aerial Vehicle (UAV)-Based Hyperspectral Classification of Desert Grassland Plants in Inner Mongolia, China},
