@ARTICLE{Walker2023143,
	author = {Walker, Ian J. and Hilgendorf, Zach and Gillies, John A. and Turner, Craig M. and Furtak-Cole, Eden and Nikolich, George},
	title = {Assessing performance of a “nature-based” foredune restoration project, Oceano Dunes, California, USA},
	year = {2023},
	journal = {Earth Surface Processes and Landforms},
	volume = {48},
