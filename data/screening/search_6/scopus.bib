@ARTICLE{Zhao2022,
	author = {Zhao, Xiaoxia and Su, Yanjun and Hu, Tianyu and Cao, Mengqi and Liu, Xiaoqiang and Yang, Qiuli and Guan, Hongcan and Liu, Lingli and Guo, Qinghua},
	title = {Analysis of UAV lidar information loss and its influence on the estimation accuracy of structural and functional traits in a meadow steppe},
	year = {2022},
