@ARTICLE{Hu202469,
	author = {Hu, Tianyu and Cao, Mengqi and Zhao, Xiaoxia and Liu, Xiaoqiang and Liu, Zhonghua and Liu, Liangyun and Huang, Zhengying and Tao, Shengli and Tang, Zhiyao and Guo, Yanpei and Ji, Chengjun and Zheng, Chengyang and Wang, Guoyan and Hu, Xiaokang and Zhou, Luhong and Cheng, Yunxiang and Ma, Wenhong and Wang, Yonghui and Zhang, Pujin and Fan, Yuejun and Yu, Feihai and Wang, Zhong and Qiao, Xiujuan and Cheng, Xiaoli and Yin, Chunying and Ma, Hongyuan and Li, Liping and Yang, Yan and Luo, Wanyin and Gong, Yanming and Wang, Lei and Chen, Leiyi and Liu, Guofang and Song, Chuangye and Yang, Xuejun and Ye, Xuehua and Zhang, Shuren and Zhu, Xiangyun and Wang, Qinggang and Li, Shijin and Yang, Yongchuan and Liu, Lingli and Kelly, Maggi and Fang, Jingyun and Su, Yanjun},
	title = {High-resolution mapping of grassland canopy cover in China through the integration of extensive drone imagery and satellite data},
	year = {2024},
	journal = {ISPRS Journal of Photogrammetry and Remote Sensing},
	volume = {218},
