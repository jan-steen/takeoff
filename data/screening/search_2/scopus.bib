	title = {Assessment of suitable Potentilla anserina habitat and its response to climate change in the source region of the Yellow River based on ensemble species distribution modeling; [基于组合物种分布模型的黄河源区鹅绒委陵菜适宜生境及其对气候变化的响应]},
	year = {2022},
	journal = {Pratacultural Science},
	volume = {39},
