@ARTICLE{Rahman2017,
	author = {Rahman, Mir Mustafizur and McDermid, Gregory J. and Strack, Maria and Lovitt, Julie},
	title = {A new method to map groundwater table in peatlands using unmanned aerial vehicles},
	year = {2017},
	journal = {Remote Sensing},
	volume = {9},
