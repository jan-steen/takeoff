@ARTICLE{Olariu2022,
	author = {Olariu, Horia G. and Malambo, Lonesome and Popescu, Sorin C. and Virgil, Clifton and Wilcox, Bradford P.},
	title = {Woody Plant Encroachment: Evaluating Methodologies for Semiarid Woody Species Classification from Drone Images},
	year = {2022},
