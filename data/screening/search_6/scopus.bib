@ARTICLE{Martínez Prentice20241411,
	author = {Martínez Prentice, Ricardo and Villoslada, Miguel and Ward, Raymond D. and Bergamo, Thaisa F. and Joyce, Chris B. and Sepp, Kalev},
	title = {Synergistic use of Sentinel-2 and UAV-derived data for plant fractional cover distribution mapping of coastal meadows with digital elevation models},
	year = {2024},
	journal = {Biogeosciences},
