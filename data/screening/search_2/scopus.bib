@ARTICLE{Wang2022236,
	author = {Wang, Yuan and Bi, Yuge},
	title = {Simplified Learning Classification Model Based on UAV Hyperspectral Remote Sensing for Desert Steppe Terrain; [基于无人机高光谱的荒漠草原地物精简学习分类模型]},
	year = {2022},
