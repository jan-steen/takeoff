	keywords = {Forestry; Image processing; Unmanned aerial vehicles (UAV); Urban growth; Vegetation; Atmospheric parameters; Differential settlement of foundations; Image analysis techniques; Interactive effect; Non-intrusive; Shoot growth; Unmanned air vehicle (UAVs); Vegetation density; Image analysis},
