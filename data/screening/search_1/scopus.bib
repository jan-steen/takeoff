	author = {Alvarez-Mendoza, Cesar I. and Guzman, Diego and Casas, Jorge and Bastidas, Mike and Polanco, Jan and Valencia-Ortiz, Milton and Montenegro, Frank and Arango, Jacobo and Ishitani, Manabu and Selvaraj, Michael Gomez},
	title = {Predictive Modeling of Above-Ground Biomass in Brachiaria Pastures from Satellite and UAV Imagery Using Machine Learning Approaches},
	year = {2022},
