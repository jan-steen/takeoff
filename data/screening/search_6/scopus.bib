@ARTICLE{Wijesingha2020391,
	author = {Wijesingha, Jayan and Astor, Thomas and Schulze-Brüninghoff, Damian and Wachendorf, Michael},
	title = {Mapping Invasive Lupinus polyphyllus Lindl. in Semi-natural Grasslands Using Object-Based Image Analysis of UAV-borne Images},
	year = {2020},
