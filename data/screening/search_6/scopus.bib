	title = {Prescribed Grass Fire Mapping and Rate of Spread Measurement Using NIR Images from a Small Fixed-Wing UAS},
	year = {2023},
	journal = {IEEE Journal of Selected Topics in Applied Earth Observations and Remote Sensing},
	volume = {16},
	pages = {3519 – 3530},
	doi = {10.1109/JSTARS.2023.3255230},
