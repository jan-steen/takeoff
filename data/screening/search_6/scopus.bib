	doi = {10.1111/2041-210X.12919},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85043508013&doi=10.1111%2f2041-210X.12919&partnerID=40&md5=52ad434ae4a6c62494099dc1476ada82},
	abstract = {Assessing habitat quality is a primary goal of ecologists. However, evaluating habitat features that relate strongly to habitat quality at fine-scale resolutions across broad-scale extents is challenging. Unmanned aerial systems (UAS) provide an avenue for bridging the gap between relatively high spatial resolution, low spatial extent field-based habitat quality measurements and lower spatial resolution, higher spatial extent satellite-based remote sensing. Our goal in this study was to evaluate the potential for UAS structure from motion (SfM) to estimate several dimensions of habitat quality that provide potential security from predators, and forage for pygmy rabbits (Brachylagus idahoensis) in a sagebrush steppe environment. At the plant and patch scales, we compared UAS-derived estimates of vegetation height, volume (estimate of food availability) and canopy cover to estimates from ground-based terrestrial laser scanning (TLS) and field-based measurements. Then, we mapped habitat features across two sagebrush landscapes in Idaho, USA, using point clouds derived from UAS SfM. At the individual plant scale, the UAS-derived estimates matched those from TLS for height (R2 = 0.85), volume (R2 = 0.94) and canopy cover (R2 = 0.68). However, there was less agreement with field-based measurements of height (R2 = 0.67), volume (R2 = 0.31) and canopy cover (R2 = 0.29). At the patch scale, UAS-derived estimates provided a better fit to field-based measurements (R2 = 0.51–0.75) than at the plant scale. Landscape-scale maps created from UAS were able to distinguish structural heterogeneity between key patch types. Our work demonstrates that UAS was able to accurately estimate habitat heterogeneity for a key terrestrial vertebrate at multiple spatial scales. Given that many of the vegetation metrics we focus on are important for a wide variety of species, our work illustrates a general remote sensing approach for mapping and monitoring fine-resolution habitat quality across broad landscapes for use in studies of animal ecology, conservation and land management. © 2017 The Authors. Methods in Ecology and Evolution © 2017 British Ecological Society},
	author_keywords = {canopy cover; habitat quality; landscape scale; patch scale; pygmy rabbit; sagebrush; structure from motion; terrestrial laser scanning; unmanned aerial vehicles; volume},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 42; All Open Access, Bronze Open Access}
}

@ARTICLE{Maire2018,
	author = {Maire, Juliette and Gibson-Poole, Simon and Cowan, Nicholas and Reay, Dave S. and Richards, Karl G. and Skiba, Ute and Rees, Robert M. and Lanigan, Gary J.},
	title = {Identifying Urine Patches on Intensively Managed Grassland Using Aerial Imagery Captured From Remotely Piloted Aircraft Systems},
	year = {2018},
	journal = {Frontiers in Sustainable Food Systems},
	volume = {2},
	doi = {10.3389/fsufs.2018.00010},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85076131449&doi=10.3389%2ffsufs.2018.00010&partnerID=40&md5=7439631f2328d29fac21f358ab0436d0},
	abstract = {The deposition of livestock urine and feces in grazed fields results in a sizable input of available nitrogen (N) in these soils; therefore significantly increasing potential nitrogen pollution from agricultural areas in the form of nitrous oxide (N2O), ammonia (NH3), and nitrate (NO3−). Livestock deposition events contributes to high spatial variability within the field and generate uncertainties when assessing the contribution that animal waste has on nitrogen pollution pathways. This study investigated an innovative technique for identifying the spatial coverage of urine deposition in grasslands without the need for manual soil measurements. A Remotely Piloted Aircraft System (RPAS) using a twin camera system was used to identify urine patches in a 5 ha field, which had been grazed by sheep 3 weeks previous to measurements. The imagery was processed using Agisoft Photoscan (Agisoft LLC) to produce true and false color orthomosaic imagery of the entire field. Imagery of five areas (225 m2) within the field were analyzed using a custom R script. For a total of 1,125 m2 of grassland, 12.2% of the area consisted of what was classified as urine patch. A simple up-scaling method was applied to these data to calculate N2O emissions for the entire field providing an estimate of 1.3–2.0 kg N2O-N ha−1 emissions from urine and fertilizer inputs. © Copyright © 2018 Maire, Gibson-Poole, Cowan, Reay, Richards, Skiba, Rees and Lanigan.},
	author_keywords = {feature detection; grassland; image analysis; nitrous oxide; RPAS; UAV; urine},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 15; All Open Access, Gold Open Access, Green Open Access}
}

@ARTICLE{Milling20181648,
	author = {Milling, Charlotte R. and Rachlow, Janet L. and Olsoy, Peter J. and Chappell, Mark A. and Johnson, Timothy R. and Forbey, Jennifer S. and Shipley, Lisa A. and Thornton, Daniel H.},
	title = {Habitat structure modifies microclimate: An approach for mapping fine-scale thermal refuge},
	year = {2018},
	journal = {Methods in Ecology and Evolution},
	volume = {9},
	number = {6},
	pages = {1648 – 1657},
	doi = {10.1111/2041-210X.13008},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85045841659&doi=10.1111%2f2041-210X.13008&partnerID=40&md5=527705090f8d56453cd84addd9853f7f},
	abstract = {Contemporary techniques predicting habitat suitability under climate change projections often underestimate availability of thermal refuges. Habitat structure contributes to thermal heterogeneity at a variety of spatial scales, but quantifying microclimates at organism-relevant resolutions remains a challenge. Landscapes that appear homogeneous at large scales may offer patchily distributed thermal refuges at finer scales. We quantified the relationship between vegetation structure and the thermal environment at a scale relevant to small, terrestrial animals using a new approach for mapping fine-scale thermal heterogeneity. We expected that vegetation would create attenuated microclimates and that the influence of vegetation structure would vary seasonally. We measured shrub volume, horizontal cover and operative temperature (Te) in a sagebrush-steppe habitat in Idaho, USA, at 534 microsites across two study sites of c. 1 km2 each. We modelled relationships between habitat structure and both mean daily maximum temperature ((Formula presented.)) and mean diurnal temperature range ((Formula presented.)) for each study site during summer and winter. Aerial imagery from unmanned aerial systems was used to estimate shrub volume and canopy cover at 1-m resolution, and we applied the best fit model to map thermal heterogeneity across broader extents. Increasing shrub volume and cover was associated with lower (Formula presented.) and (Formula presented.), but strengths of the relationships differed between study sites. There was considerable heterogeneity in availability of thermal refuges across sagebrush-steppe rangelands that have traditionally been considered relatively homogeneous. This technique can help ecologists and land managers identify critical thermal refuges that large-scale climate modelling can overlook and thus contribute to an understanding of animal–habitat relationships under changing climates and land uses. © 2018 The Authors. Methods in Ecology and Evolution © 2018 British Ecological Society},
	author_keywords = {Climate change; FRAGSTATS; operative temperature; predictive mapping; thermal map; thermal refuge; UAS; unmanned aerial systems},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
