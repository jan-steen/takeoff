	author = {Qin, Yu and Sun, Yi and Zhang, Wei and Qin, Yan and Chen, Jianjun and Wang, Zhiwei and Zhou, Zhaoye},
	title = {Species monitoring using unmanned aerial vehicle to reveal the ecological role of Plateau pika in maintaining vegetation diversity on the northeastern Qinghai-Tibetan Plateau},
	year = {2020},
	journal = {Remote Sensing},
	volume = {12},
	number = {15},
