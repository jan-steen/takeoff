	title = {Using an unmanned aerial vehicle (UAV) for lake management: Ecological status, lake regime shift and stratification processes in a small Mediterranean karstic lake; [Uso de un vehículo aéreo no tripulado (VANT) para la gestión de lagos: Estado ecológico, cambio de régimen y procesos de estratificación en una pequeña laguna cárstica mediterránea]},
	year = {2022},
	journal = {Limnetica},
	volume = {41},
