	title = {The Evapotranspiration Characteristics and Evaporative Cooling Effects of Different Vegetation Types on an Intensive Green Roof: Dynamic Performance Under Different Weather Conditions},
	year = {2024},
	journal = {Sustainability (Switzerland)},
	volume = {16},
