@ARTICLE{Stander2021371,
	author = {Stander, Roald and Walker, David J. and Rohwer, Frank C. and Baydack, Richard K.},
	title = {Drone Nest Searching Applications Using a Thermal Camera},
	year = {2021},
	journal = {Wildlife Society Bulletin},
	volume = {45},
