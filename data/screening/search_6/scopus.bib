}

@ARTICLE{Heumann201529,
	author = {Heumann, Benjamin W. and Hackett, Rachel A. and Monfils, Anna K.},
	title = {Testing the spectral diversity hypothesis using spectroscopy data in a simulated wetland community},
	year = {2015},
	journal = {Ecological Informatics},
	volume = {25},
	pages = {29 – 34},
	doi = {10.1016/j.ecoinf.2014.10.005},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84910661525&doi=10.1016%2fj.ecoinf.2014.10.005&partnerID=40&md5=0f87020afb8b9fda4b35c5808514e305},
	abstract = {The spectral diversity hypothesis proposes that as the number of plant species increases for a given area, the diversity of spectra observed from that area should also increase. This approach could be very useful as an assessment and monitoring tool to help ecologists understand the spatial and temporal patterns of biodiversity without relying on consistently detecting individual species. While the spectral diversity hypothesis has been examined for a wide range of ecosystems using a variety of remote sensing data, it has not been tested using spectroscopy (i.e. hyperspectral) data for wetlands. Previous studies have not explicitly considered the impact that flowers may have on spectral diversity and how this may impact the spectral diversity hypothesis. To test the spectral diversity hypothesis and the potential impact on flowers, we used a simulation approach to combine leaf and flower spectra collected from a diverse prairie fen wetland ecosystem into datasets of virtual plots with varying levels of species diversity and different combination of species. To address the high dimensionality of the data, we compared spectral diversity and floristic diversity using partial least squares regression. Our results found that defining floristic diversity using the Shannon's diversity index, which accounts for plant abundance in each plot, produced the best predictive models where the predicted values had a RMSE less than 40% of the mean observed value. We also found that the inclusion of flower spectra with leaf spectra did increase the RMSE of the best model, but across all models, correlation increased. Our results indicate that spectral diversity could be used as an initial biodiversity assessment tool for wetlands, especially with on-going advancements in unmanned aerial vehicle technology that can provide a low altitude platform for imaging spectroscopy. © 2014 Elsevier B.V.},
	author_keywords = {Biodiversity; Flower; Hyperspectral; Prairie fen; Spectroscopy; Wetlands},
	keywords = {diversity index; fen; floristics; flower; prairie; remote sensing; satellite data; spatiotemporal analysis; species diversity; spectral analysis; spectroscopy; wetland; abundance; biodiversity; data set; environmental assessment; hypothesis testing; leaf; plant community},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 33}
}

@ARTICLE{Hays2018,
	author = {Hays, Graeme C. and Alcoverro, Teresa and Christianen, Marjolijn J.A. and Duarte, Carlos M. and Hamann, Mark and Macreadie, Peter I. and Marsh, Helene D. and Rasheed, Michael A. and Thums, Michele and Unsworth, Richard K.F. and York, Paul H. and Esteban, Nicole},
	title = {New tools to identify the location of seagrass meadows: Marine grazers as habitat indicators},
	year = {2018},
	journal = {Frontiers in Marine Science},
	volume = {4},
	number = {FEB},
	doi = {10.3389/fmars.2018.00009},
