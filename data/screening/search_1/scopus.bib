@ARTICLE{Huang2024,
	author = {Huang, Haolin and Wang, Zhihui and Chen, Junjie and Shi, Yonglei},
	title = {Improving Tree Cover Estimation for Sparse Trees Mixed with Herbaceous Vegetation in Drylands Using Texture Features of High-Resolution Imagery},
	year = {2024},
	journal = {Forests},
	volume = {15},
	number = {5},
