@ARTICLE{77,
date_generated={JAN 28},
language={English},
author={Chen, JX and Yin, JX and Jiang, YB and Kang, YX and Ma, YL and Qi, GP and Jin, CG and Xie, BJ and Yu, WJ and Wang, YB and Chen, JX and Zhu, JP and Li, BD},
address={Gansu Agr Univ, Coll Water Conservancy & Hydrpower Engn, Lanzhou 730070, Peoples R China and Zhejiang Inst Qual Sci, Hangzhou 310018, Peoples R China and Qingyang Hydrol & Water Resources Survey Ctr, Qingyang 745000, Peoples R China},
