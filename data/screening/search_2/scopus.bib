@ARTICLE{Patel2025,
	author = {Patel, Shivani and Wong, John MK and Tapales, Kristina and Al-Maslamani, Ibrahim},
	title = {First photographic evidence of probable twin dugongs and 2024 dugong population structure study in Qatar},
	year = {2025},
	journal = {Journal for Nature Conservation},
	volume = {84},
	doi = {10.1016/j.jnc.2025.126838},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85215612878&doi=10.1016%2fj.jnc.2025.126838&partnerID=40&md5=0e467bbbdefb944fbe514b1f5039a6ef},
	abstract = {This research aims to fill a significant research gap in the study of dugong populations in Qatar, where data on population status of this vulnerable species in the Arabian gulf has been limited. Conducted during 2023–2024, this study evaluates dugong population structure in Northwestern Qatar, focusing on the mother-calf ratios, and the need for cooperative conservation efforts between Qatar and Bahrain. We used Unmanned Aerial Vehicles (UAVs) to survey dugongs in seagrass meadows off the coast of Al-Zubara. The UAVs, flown at various altitudes, captured detailed data on dugong behavior, body size, and social structure. We recorded 224 dugongs, including 197 adults and 27 calves, and the first photographic evidence of probable twin dugongs in the Arabian Gulf, observed in both 2023 and 2024. This repeated sighting suggests that the region may serve as an important nursery habitat with a specific calving season. The study also revealed that dugongs often form large herds led by mature adults, with calves protected in the center of the herd. UAVs allowed us to identify individual dugongs through unique body markings, providing valuable data for monitoring their health, population size and movements over time. The findings underscore the need for continuous environmental monitoring and highlight the importance of transboundary management action plan between Qatar and Bahrain to protect key dugong habitats, especially during breeding and calving seasons. The study also recommends further research in the southeastern waters between Qatar and the UAE to improve conservation strategies across the Southern Arabian Gulf. This research enhances our understanding of dugong populations in Qatar and demonstrates the effectiveness of drone technology in marine conservation. © 2025 Elsevier GmbH},
	author_keywords = {Arabian Gulf; Dugong dugon; Transboundary conservation; Twin Marine mammal},
	keywords = {Arabian Sea; Indian Ocean; Persian Gulf; Qatar; body size; conservation management; marine mammal; population dynamics; unmanned vehicle},
	type = {Article},
	publication_stage = {Final},
