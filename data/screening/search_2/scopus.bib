@ARTICLE{Laermanns2018453,
	author = {Laermanns, Hannes and Kirkitadze, Giorgi and May, Simon Matthias and Kelterbaum, Daniel and Opitz, Stephan and Heisterkamp, Arne and Basilaia, Giorgi and Elashvili, Mikheil and Brückner, Helmut},
	title = {Bronze Age settlement mounds on the Colchian plain at the Black Sea coast of Georgia: A geoarchaeological perspective},
	year = {2018},
	journal = {Geoarchaeology},
