	source = {Scopus},
	note = {Cited by: 2; All Open Access, Gold Open Access}
}

@ARTICLE{Lim20243960,
	author = {Lim, Jeonggeun and Kim, Myeonggyun and Yoo, Hyungwook and Lee, Jongho},
	title = {Autonomous Multirotor UAV Search and Landing on Safe Spots Based on Combined Semantic and Depth Information From an Onboard Camera and LiDAR},
