@ARTICLE{Valle202372,
	author = {Valle, Roberto G. and Verza, Emiliano and Scarton, Francesco},
	title = {Do the barrier islands of the Po Delta constitute an ecological trap for colonising Slender-billed Gulls Larus genei?},
	year = {2023},
	journal = {Ornis Hungarica},
	volume = {31},
	number = {1},
	pages = {72 – 87},
	doi = {10.2478/orhu-2023-0005},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85162262291&doi=10.2478%2forhu-2023-0005&partnerID=40&md5=d058100843ae69de80064ca4ae76df48},
	abstract = {The Slender-billed Gull (Larus genei) breeds with a scattered distribution on an extensive nesting area, ranging from India and Afghanistan in the East to the Iberian Peninsula in the West, including the Mediterranean and the Black Sea. A number of habitats are used for breeding, such as sand-spits and beaches along coasts and islands of land-locked seas, steppe lakes, but also brackish or freshwater lagoons near river deltas. Sea level rise dramatically affects coastal sites, thus being the greatest threat to the survival of many seabird species, including gulls. This note describes habitat selection, breeding success and causes of failure of Slender-billed Gulls during their colonisation of the northern Po Delta (NE Italy) during 2018-2022. Slender-billed Gulls colonised the northern Po Delta in 2018. Six colonies were found during the study period. Birds used both natural barrier islands and artificial dredge islands. Productivity in the first five years after the colonisation event was zero, mostly due to colony sites being flooded by high tides and storms. If Slender-billed Gulls will switch to nest in nearby fish farms, these could provide plenty of suitable breeding sites, safe from tidal flooding and with very low predation pressure, allowing sufficient productivity. At the moment, Slender-billed Gulls are unsuccessful in colonising the barrier islands of the Po Delta. © 2023 Roberto G. Valle et al., published by Sciendo.},
	author_keywords = {breeding; drones; habitat selection; productivity; sea level rise},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; All Open Access, Gold Open Access}
}

@ARTICLE{Wang2023,
	author = {Wang, Shengli and Bi, Yuge and Du, Jianmin and Zhang, Tao and Gao, Xinchao and Jin, Erdmt},
	title = {The Unmanned Aerial Vehicle (UAV)-Based Hyperspectral Classification of Desert Grassland Plants in Inner Mongolia, China},
	year = {2023},
	journal = {Applied Sciences (Switzerland)},
	volume = {13},
	number = {22},
	doi = {10.3390/app132212245},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85192374411&doi=10.3390%2fapp132212245&partnerID=40&md5=8bc90fff2de1ef0c2713b362bc3f7fcf},
	abstract = {In recent years, grassland ecosystems have faced increasingly severe desertification, which has caused continuous changes in the vegetation composition in grassland ecosystems. Therefore, effective research on grassland plant taxa is crucial to exploring the process of grassland desertification. This study proposed a solution by constructing a UAV hyperspectral remote sensing system to collect the hyperspectral data of various species in desert grasslands. This approach overcomes the limitations of traditional grassland survey methods such as a low efficiency and insufficient spatial resolution. A streamlined 2D-CNN model with different feature enhancement modules was constructed, and an improved depth-separable convolution approach was used to classify the desert grassland plants. The model was compared with existing hyperspectral classification models, such as ResNet34 and DenseNet121, under the preprocessing condition of data downscaling by combining the variance and F-norm2. The results showed that the model outperformed the other models in terms of the overall classification accuracy, kappa coefficient, and memory occupied, achieving 99.216%, 98.735%, and 16.3 MB, respectively. This model could effectively classify desert grassland species. This method provides a new approach for monitoring grassland ecosystem degradation. © 2023 by the authors.},
	author_keywords = {desert grassland; hyperspectral remote sensing; lightweight network; species classification; UAV},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 3; All Open Access, Gold Open Access}
}

@ARTICLE{Jarrett2023,
	author = {Jarrett, Sean and Hölbling, Daniel},
	title = {Spatial Evaluation of a Natural Flood Management Project Using SAR Change Detection},
	year = {2023},
	journal = {Water (Switzerland)},
	volume = {15},
	number = {12},
	doi = {10.3390/w15122182},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85163837789&doi=10.3390%2fw15122182&partnerID=40&md5=3073938340783a2b2a968a6f10f1c698},
	abstract = {This study proposes an evaluation method using C-band Sentinel-1 synthetic aperture radar (SAR) data to provide evidence of flood characteristic changes after the restoration of a floodplain. A portable, flexible evaluation framework has replicated previous change detection research approaches to analyse a Natural Flood Management (NFM) project on the Sussex Ouse river in southern England, conducted by the Sussex Flow Initiative (SFI), to ascertain how control measures have helped mitigate flood risk. GIS operations were conducted on the mapped results of the change detection procedure to identify how flood area, form and compactness have been affected after the NFM installation restored a floodplain to slow river flow and how these changes relate to the overall aims of the project. Innovative means were employed to verify the change detection methodology by sampling flood records from internet-published drone footage. The overall accuracy achieved using the Change Detection and Thresholding (CDAT) technique was 75%. The use of SAR data provides evidence of how NFM features function during significant flood events, providing a mapped delineation of the actual flood extent. A comprehensive scorecard has been developed to evaluate the positive and negative outcomes of the spatial changes that have manifested in post-restoration floods, in comparison to inundation before the installation. Results from this study have been included in the annual report of the SFI project to demonstrate how key features have attenuated flood waters in accordance with design intentions. © 2023 by the authors.},
	author_keywords = {change detection; flood mapping; GIS; natural flood management; nature-based solutions; remote sensing; SAR; Sentinel-1; thresholding; water delineation},
	keywords = {England; Sussex; United Kingdom; Banks (bodies of water); Change detection; Flood control; Floods; Geographic information systems; Restoration; Risk assessment; Synthetic aperture radar; Change detection; Flood management; Flood mapping; Natural flood; Natural flood management; Nature-based solution; Remote-sensing; Sentinel-1; Thresholding; Water delineation; flood; floodplain; geomorphological mapping; GIS; remote sensing; synthetic aperture radar; Remote sensing},
