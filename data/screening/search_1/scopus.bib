@ARTICLE{Jarrett2023,
	author = {Jarrett, Sean and Hölbling, Daniel},
	title = {Spatial Evaluation of a Natural Flood Management Project Using SAR Change Detection},
	year = {2023},
	journal = {Water (Switzerland)},
	volume = {15},
	number = {12},
	doi = {10.3390/w15122182},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85163837789&doi=10.3390%2fw15122182&partnerID=40&md5=3073938340783a2b2a968a6f10f1c698},
	abstract = {This study proposes an evaluation method using C-band Sentinel-1 synthetic aperture radar (SAR) data to provide evidence of flood characteristic changes after the restoration of a floodplain. A portable, flexible evaluation framework has replicated previous change detection research approaches to analyse a Natural Flood Management (NFM) project on the Sussex Ouse river in southern England, conducted by the Sussex Flow Initiative (SFI), to ascertain how control measures have helped mitigate flood risk. GIS operations were conducted on the mapped results of the change detection procedure to identify how flood area, form and compactness have been affected after the NFM installation restored a floodplain to slow river flow and how these changes relate to the overall aims of the project. Innovative means were employed to verify the change detection methodology by sampling flood records from internet-published drone footage. The overall accuracy achieved using the Change Detection and Thresholding (CDAT) technique was 75%. The use of SAR data provides evidence of how NFM features function during significant flood events, providing a mapped delineation of the actual flood extent. A comprehensive scorecard has been developed to evaluate the positive and negative outcomes of the spatial changes that have manifested in post-restoration floods, in comparison to inundation before the installation. Results from this study have been included in the annual report of the SFI project to demonstrate how key features have attenuated flood waters in accordance with design intentions. © 2023 by the authors.},
	author_keywords = {change detection; flood mapping; GIS; natural flood management; nature-based solutions; remote sensing; SAR; Sentinel-1; thresholding; water delineation},
	keywords = {England; Sussex; United Kingdom; Banks (bodies of water); Change detection; Flood control; Floods; Geographic information systems; Restoration; Risk assessment; Synthetic aperture radar; Change detection; Flood management; Flood mapping; Natural flood; Natural flood management; Nature-based solution; Remote-sensing; Sentinel-1; Thresholding; Water delineation; flood; floodplain; geomorphological mapping; GIS; remote sensing; synthetic aperture radar; Remote sensing},
