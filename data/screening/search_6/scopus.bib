}

@ARTICLE{Wu2023,
	author = {Wu, Songjun and Tetzlaff, Doerthe and Daempfling, Hauke and Soulsby, Chris},
	title = {Improved understanding of vegetation dynamics and wetland ecohydrology via monthly UAV-based classification},
	year = {2023},
	journal = {Hydrological Processes},
	volume = {37},
	number = {9},
	doi = {10.1002/hyp.14988},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85170650239&doi=10.1002%2fhyp.14988&partnerID=40&md5=e05e19d2a059a162af4cfa1a570f7e5a},
	abstract = {Vegetation classification is an essential prerequisite for understanding vegetation-water relations at a range of spatial scales. However, in site-specific applications, such classifications were mostly based on a single Unmanned Aerial Vehicle (UAV) flight, which can be challenging in grasslands and/or herbaceous-dominated systems, as those communities are small in size and highly mixed. Here, we conducted monthly UAV flights for two years in a riparian wetland in Germany, with acquired imagery used for vegetation classification on a monthly basis under different strategies (with or without auxiliary information from other flights) to increase understanding in ecohydrology. The results show that multi-flight-based classification outperformed single-flight-based classification due to the higher classification accuracy. Moreover, improved sensitivity of temporal changes in community distribution highlights the benefits of multi-flight-based classification - providing a more comprehensive picture of community evolution. From reference to the monthly community distribution, we argue that a combination of two or three flights in early- and late-summer is enough to achieve comparable results to monthly flights, while mid-summer would be a better timing in case only one flight is scheduled. With such detailed vegetation mapping, we further interpreted the complex spatio-temporal heterogeneity in NDVI and explored the dominant areas and developmental progress of each community. Impacts from management (mowing events) were also evaluated based on the different responses between communities in two years. Finally, we explored how such vegetation mapping could help understand landscape ecohydrology, and found that the spatio-temporal distribution of minimal soil moisture was related to NDVI peaks of local community, while grass distribution was explained by both topography and low moisture conditions. Such bi-directional relationships proved that apart from contributing to an evidence base for wetland management, multi-flight UAV vegetation mapping could also provide fundamental insights into the ecohydrology of wetlands. © 2023 The Authors. Hydrological Processes published by John Wiley & Sons Ltd.},
	author_keywords = {ecohydrology; remote sensed vegetation dynamics; soil moisture; UAV; unmanned aerial vehicles; wetlands},
	keywords = {Germany; Antennas; Classification (of information); Remote sensing; Topography; Unmanned aerial vehicles (UAV); Vegetation mapping; Wetlands; Aerial vehicle; Eco-hydrology; Remote sensed vegetation dynamic; Unmanned aerial vehicle; Vegetation classification; Vegetation dynamics; Vegetation mapping; Water relations; ecohydrology; grassland; remote sensing; soil moisture; unmanned vehicle; vegetation classification; vegetation dynamics; vegetation mapping; wetland; Soil moisture},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 3; All Open Access, Green Open Access, Hybrid Gold Open Access}
}

@ARTICLE{Du2023,
	author = {Du, Bobo and Ding, Xiaolong and Ji, Chao and Lin, Kejian and Guo, Jing and Lu, Longhui and Dong, Yingying and Huang, Wenjiang and Wang, Ning},
	title = {Estimating Leymus chinensis Loss Caused by Oedaleus decorus asiaticus Using an Unmanned Aerial Vehicle (UAV)},
	year = {2023},
	journal = {Remote Sensing},
	volume = {15},
	number = {17},
	doi = {10.3390/rs15174352},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85170368382&doi=10.3390%2frs15174352&partnerID=40&md5=a0eb010a4f92330100a06ac47e942928},
	abstract = {Oedaleus decorus asiaticus is one of the dominant harmful pests in central Inner Mongolia, China. Large-scale outbreaks of this pest create many serious problems in animal husbandry and agriculture. Therefore, understanding the underlying mechanisms between plant losses and Odecorus at different density levels and growth stages can guide the development of monitoring and prediction measures to reduce damage. In this study, an unmanned aerial vehicle (UAV) carrying a camera was employed to collect multi-spectral data. Further, nine vegetation indices (VIs) were analyzed to explore the most suitable indices for estimating plant loss caused by O. decorus in different growth stages. The following results were obtained: (1) The second instar nymphs of O. decorus could promote vegetation growth. As the density level in each cage increased, the biomass of each cage increased (nymph density < 30 nymphs/m2) and then decreased (nymph density ≥ 30 nymphs/m2). When nymph density was greater than 60 nymphs/m2, the biomass in those cages decreased significantly. (2) With respect to the control group, large damage began to emerge during the third instar nymphal stage. In particular, the largest vegetation loss was caused by fourth nymphal larvae. (3) The ratio vegetation index (RVI) appeared as the most excellent index for reflecting Leymus chinensis loss caused by O. decorus at different growth stages. Nevertheless, the difference vegetation index (DVI) was better than the RVI in the fifth instar nymphal stage. © 2023 by the authors.},
	author_keywords = {density level of O. decorus; multi-spectral data; SiZiWangQi grassland; unmanned aerial vehicle (UAV); vegetation indices},
	keywords = {Ecology; Unmanned aerial vehicles (UAV); Vegetation; Aerial vehicle; Density level of O decorus; Density levels; Different growth stages; Leymus chinensis; Multi-spectral data; Ratio vegetation indices; Siziwangqi grassland; Unmanned aerial vehicle; Vegetation index; Antennas},
