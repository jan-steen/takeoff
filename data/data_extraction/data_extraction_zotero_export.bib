	journal = {Agronomy Journal},
	author = {Bretas, Igor L. and Dubeux, Jose C. B. and Zhao, Chang and Queiroz, Luana M. D. and Flynn, Scott and Ingram, Sam and Oduor, Kenneth T. and Cruz, Priscila J. R. and Ruiz‐Moreno, Martin and Loures, Daniele R. S. and Valente, Domingos S. M. and Chizzotti, Fernanda H. M.},
	month = may,
	year = {2024},
