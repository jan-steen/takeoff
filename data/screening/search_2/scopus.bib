@ARTICLE{Lima2023,
	author = {Lima, Mayara Lopes de Freitas and de Souza, Samara Maria Farias and de Sá, Isabelle Ventura and Santana, Otacilio Antunes},
	title = {Deep learning with aerial surveys for extensive livestock hotspot recognition in the Brazilian Semi-arid Region; [Deep learning no levantamento aéreo de hotspots para pecuária extensiva no Semiárido Brasileiro]},
	year = {2023},
	journal = {Ciencia e Agrotecnologia},
