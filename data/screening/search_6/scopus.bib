@ARTICLE{Higgisson20211312,
	author = {Higgisson, William and Cobb, Adrian and Tschierschke, Alica and Dyer, Fiona},
	title = {Estimating the cover of Phragmites australis using unmanned aerial vehicles and neural networks in a semi-arid wetland},
	year = {2021},
	journal = {River Research and Applications},
	volume = {37},
	number = {9},
	pages = {1312 – 1322},
