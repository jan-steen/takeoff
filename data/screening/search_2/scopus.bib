	source = {Scopus},
	note = {Cited by: 4; All Open Access, Gold Open Access, Green Open Access}
}

@ARTICLE{Kaimaris2023,
	author = {Kaimaris, Dimitris and Tsokas, Dimitris},
	title = {Application of UAS with Remote Sensing Sensors for the Location of Marks in the Archaeological Site of the Europos, Greece},
	year = {2023},
