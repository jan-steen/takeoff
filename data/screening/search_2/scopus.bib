@ARTICLE{Quan20241516,
	author = {Quan, Sinong and Duan, Yancui and Wang, Wei and Xing, Shiqi and Xu, Zhenhai and Xiao, Shunping},
	title = {PolSAR vehicle detection based on refined polarimetric decomposition; [基于精细极化分解的 PolSAR 车辆目标检测方法]},
	year = {2024},
	journal = {Scientia Sinica Informationis},
	volume = {54},
	number = {6},
	pages = {1516 – 1532},
	doi = {10.1360/SSI-2023-0337},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85213988855&doi=10.1360%2fSSI-2023-0337&partnerID=40&md5=cc5bfa7aa1ca45b4270045602479db24},
	abstract = {Polarimetric synthetic aperture radar (PolSAR) can acquire full target polarization information, playing an important role in man-made target scattering mechanism interpretation and in target detection, classification, and recognition, etc. Vehicle detection of PolSAR image is especially critical for applications such as environmental surveillance and traffic management. Different from ships on the sea, the terrain backgrounds of vehicles are generally more complex, consisting of grass, trees, buildings, roads, etc. These result in complicated background clutters and intense artificial clutter interferences, which pose major challenges for PolSAR vehicle detection. It is widely known that accurate interpretation of vehicle scattering is the momentous foundation for polarimetric feature extraction and target detection. To accurately characterize the vehicle scattering behaviors, we construct a rotated dihedral scattering model (RDSM), and then propose a refined five-component decomposition method. Afterward, through analyzing the scattering differences between vehicles and their terrain backgrounds, we present a scattering power composite detector for PolSAR vehicle detection. The experimental results on two measured UAV-borne SAR datasets demonstrate the proposed method can significantly enhance the target-to-clutter ratios (TCR) of vehicles and achieve superior detection performance. In addition, it can remain complete contours and details of vehicles, contributing to subsequent target classification, recognition and so on. © 2024 Science Press. All rights reserved.},
	author_keywords = {polarimetric synthetic aperture radar (PolSAR); refined polarimetric decomposition; rotated dihedral scattering; scattering power composite feature; vehicle detection},
	type = {Article},
