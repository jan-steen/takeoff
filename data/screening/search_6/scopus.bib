@ARTICLE{Pakeman2025,
	author = {Pakeman, Robin J. and Bienkowski, Damian and Fielding, Debbie A. and Thiel, Andre and Evans, Darren M.},
	title = {Assessing the impacts of livestock grazing on upland bird breeding territories using drone surveys},
	year = {2025},
	journal = {Journal of Avian Biology},
	volume = {2025},
