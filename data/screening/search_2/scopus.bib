}@ARTICLE{Reis2019178,
	author = {Reis, Bruna Paolinelli and Martins, Sebastião Venâncio and Fernandes Filho, Elpídio Inácio and Sarcinelli, Tathiane Santi and Gleriani, José Marinaldo and Leite, Helio Garcia and Halassy, Melinda},
	title = {Forest restoration monitoring through digital processing of high resolution images},
