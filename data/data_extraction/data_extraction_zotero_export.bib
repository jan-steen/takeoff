@article{wang_modeling_2017,
	title = {Modeling {Aboveground} {Biomass} in {Hulunber} {Grassland} {Ecosystem} by {Using} {Unmanned} {Aerial} {Vehicle} {Discrete} {Lidar}},
	volume = {17},
	copyright = {https://creativecommons.org/licenses/by/4.0/},
	issn = {1424-8220},
	url = {https://www.mdpi.com/1424-8220/17/1/180},
	doi = {10.3390/s17010180},
	abstract = {Accurate canopy structure datasets, including canopy height and fractional cover, are required to monitor aboveground biomass as well as to provide validation data for satellite remote sensing products. In this study, the ability of an unmanned aerial vehicle (UAV) discrete light detection and ranging (lidar) was investigated for modeling both the canopy height and fractional cover in Hulunber grassland ecosystem. The extracted mean canopy height, maximum canopy height, and fractional cover were used to estimate the aboveground biomass. The influences of flight height on lidar estimates were also analyzed. The main findings are: (1) the lidar-derived mean canopy height is the most reasonable predictor of aboveground biomass (R2 = 0.340, root-mean-square error (RMSE) = 81.89 g·m−2, and relative error of 14.1\%). The improvement of multiple regressions to the R2 and RMSE values is unobvious when adding fractional cover in the regression since the correlation between mean canopy height and fractional cover is high; (2) Flight height has a pronounced effect on the derived fractional cover and details of the lidar data, but the effect is insignificant on the derived canopy height when the flight height is within the range ({\textless}100 m). These findings are helpful for modeling stable regressions to estimate grassland biomass using lidar returns.},
	language = {en},
	number = {1},
	urldate = {2025-05-27},
	journal = {Sensors},
	author = {Wang, Dongliang and Xin, Xiaoping and Shao, Quanqin and Brolly, Matthew and Zhu, Zhiliang and Chen, Jin},
	month = jan,
	year = {2017},
	pages = {180},
	file = {Volltext:files/12049/Wang et al. - 2017 - Modeling Aboveground Biomass in Hulunber Grassland.pdf:application/pdf},
}

