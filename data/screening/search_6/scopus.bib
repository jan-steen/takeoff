@ARTICLE{Zhang2022120,
	author = {Zhang, Tao and Du, Jianmin and Zhang, Haijun and Pi, Weiqiang and Gao, Xinchao and Zhu, Xiangbing},
	title = {Research on recognition method of desert steppe rat hole based on unmanned aerial vehicle hyperspectral; [基于无人机高光谱荒漠草原鼠洞识别方法研究]},
	year = {2022},
	journal = {Guangdianzi Jiguang/Journal of Optoelectronics Laser},
	volume = {33},
	number = {2},
	pages = {120 – 126},
	doi = {10.16136/j.joel.2022.02.0362},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85129448779&doi=10.16136%2fj.joel.2022.02.0362&partnerID=40&md5=c1718eec929b4e21b829b66967fa20e4},
	abstract = {In recent years, the rodent damage has been increasing on our country's grassland year by year. Grassland rodent damage not only aggravates the process of soil erosion and desertification, but also causes plague. The number of rat holes is an important index for rodent damage monitoring and grade evaluation in our country. Now the manual survey method has many problems, such as low precision, time-consuming and labor-consuming, high investigation cost, only suitable for small area investigation, and so on. It is difficult to meet the requirements of large area real-time monitoring and research. Dynamic and real-time monitoring of the number of rat holes is an important means to effectively formulate anti-rodent measures and prevent the occurrence of plague. In this study, the data of desertified grassland was collected by high spectrometer carried by unmanned aerial vehicle (UAV), and the rat hole index (RHI) was proposed to identify the rat hole in the grassland. The results show that the overall accuracy of identifying prairie rat holes by RHI index can reach 97% and the Kappa coefficient can reach 0.93.Compared with normalized difference vegetation index (NDVI), soil-adjusted vegetation index (SAVI) and ratio vegetation index (RVI) vegetation index models, this model has higher recognition accuracy. The proposal of RHI can effectively improve the accuracy and efficiency of rat hole identification in grassland, and provide an effective method for rodent control and grassland degradation monitoring and research. © 2022, The Editorial Department of Journal of Optoelectronics•Laser. All right reserved.},
	author_keywords = {Desert grassland; Hyperspectral image; Rat hole index (RHI); Recognition and classification},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 6}
}

@ARTICLE{Che2021,
