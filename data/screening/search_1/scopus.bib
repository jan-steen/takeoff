@ARTICLE{Thomas2020336,
	author = {Thomas, Amanda F. and Frazier, Amy E. and Mathews, Adam J. and Cordova, Carlos E.},
	title = {Impacts of Abrupt Terrain Changes and Grass Cover on Vertical Accuracy of UAS-SfM Derived Elevation Models},
	year = {2020},
	journal = {Papers in Applied Geography},
	volume = {6},
