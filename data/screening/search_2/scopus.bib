	author = {Estrada Zúñiga, Andrés Corsino and Astete Canal, Dante and Cárdenas Rodríguez, Jim and Alvarez Medina, Dunker Arturo and Bejar Saya, Juan Víctor and Moscoso Muñoz, Juan Elmer},
	title = {Unmanned aerial systems and passive remote sensors to classify microecosystems of high Andean grasslands; [Sistemas aéreos não tripulados e sensoriamento remoto passivo para classificar microecossistemas de pastagens altas andinas]; [Sistemas aéreos no tripulados y sensores remotos pasivos para clasificar microecosistemas de pastizales alto andinos]},
