@ARTICLE{Medeiros2023,
	author = {Medeiros, Thaís Pereira de and Morellato, Leonor Patrícia Cerdeira and Silva, Thiago Sanna Freire},
	title = {Spatial distribution and temporal variation of tropical mountaintop vegetation through images obtained by drones},
	year = {2023},
