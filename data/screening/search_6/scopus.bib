	title = {Spatiotemporal evolution of vegetation coverage in Alhagi sparsifolia Reserve in Turpan Basin, Xinjiang; [吐鲁番盆地骆驼刺保护区植被覆盖度时空演变]},
	year = {2021},
	journal = {Arid Zone Research},
	volume = {38},
