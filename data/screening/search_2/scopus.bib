	title = {ESTIMATING INVASIVE GRASSES HEIGHTS WITH IMAGES FROM A UNMANNED AERIAL VEHICLE IN BRAZILIAN CERRADO: ACCURACY OF GLOBAL NAVIGATION SATELLITE SYSTEM FROM PHANTOM 4; [ESTIMANDO A ALTURA DE GRAMÍNEAS INVASORAS COM IMAGENS DE UM VEÍCULO AÉREO NÃO TRIPULADO NO CERRADO BRASILEIRO: PRECISÃO DO SISTEMA GLOBAL DE NAVEGAÇÃO POR SATÉLITE DO PHANTOM 4]; [ESTIMACIÓN DE ALTURAS DE PASTOS INVASORES CON IMÁGENES DE UN VEHÍCULO AÉREO NO TRIPULADO EN EL CERRADO BRASILEÑO: PRECISIÓN DEL SISTEMA DE NAVEGACIÓN POR SATÉLITE GLOBAL DEL PHANTOM 4]},
	year = {2021},
	journal = {Revista de Geociencias do Nordeste},
