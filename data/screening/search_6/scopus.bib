@ARTICLE{Hunt20191,
	author = {Hunt, E. Raymond and Daughtry, Craig S. T. and Stern, Alan J. and Russ, Andrew L.},
	title = {Linear Transects of Imagery Increase Crop Monitoring Efficiency Using Fixed-Wing Unmanned Aircraft Systems},
	year = {2019},
