	author = {Qin, Yu and Yi, Shuhua and Ding, Yongjian and Qin, Yan and Zhang, Wei and Sun, Yi and Hou, Xiumin and Yu, Hongyan and Meng, Baoping and Zhang, Huifang and Chen, Jianjun and Wang, Zhiwei},
	title = {Effects of plateau pikas’ foraging and burrowing activities on vegetation biomass and soil organic carbon of alpine grasslands},
