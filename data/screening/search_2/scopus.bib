@ARTICLE{Tseng2023,
	author = {Tseng, Kuo-Hsin and Yang, Tsun-Hua and Chen, Pei-Yuan and Chien, Hwa and Chen, Chi-Farn and Hung, Yi-Chan},
	title = {Exploring the Feasibility of Mitigating Flood Hazards by an Existing Pond System in Taoyuan, Taiwan},
	year = {2023},
