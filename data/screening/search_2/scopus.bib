@ARTICLE{Zhou2022,
	author = {Zhou, Quan and Yu, Linfeng and Zhang, Xudong and Liu, Yujie and Zhan, Zhongyi and Ren, Lili and Luo, Youqing},
	title = {Fusion of UAV Hyperspectral Imaging and LiDAR for the Early Detection of EAB Stress in Ash and a New EAB Detection Index—NDVI(776,678)},
	year = {2022},
	journal = {Remote Sensing},
