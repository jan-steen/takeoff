}

@ARTICLE{Izumida20171505,
	author = {Izumida, Atsuto and Uchiyama, Shoichiro and Sugai, Toshihiko},
	title = {Application of UAV-SfM photogrammetry and aerial lidar to a disastrous flood: Repeated topographic measurement of a newly formed crevasse splay of the Kinu River, central Japan},
	year = {2017},
	journal = {Natural Hazards and Earth System Sciences},
	volume = {17},
