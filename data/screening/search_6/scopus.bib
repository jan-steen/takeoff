@ARTICLE{Gross2014892,
	author = {Gross, John W. and Heumann, Benjamin W.},
	title = {Can flowers provide better spectral discrimination between herbaceous wetland species than leaves?},
	year = {2014},
	journal = {Remote Sensing Letters},
	volume = {5},
