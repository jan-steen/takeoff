@ARTICLE{Zhang202115,
	author = {Zhang, Wei and Yi, Shu-Hua and Qin, Yu and Shangguan, Dong-Hui and Qin, Yan},
	title = {Analysis of features and influencing factors of alpine meadow surface temperature based on UAV thermal thermography; [基于无人机的高寒草甸地表温度监测及影响因素研究]},
	year = {2021},
	journal = {Acta Prataculturae Sinica},
	volume = {30},
