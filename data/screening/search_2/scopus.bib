}

@ARTICLE{Li2021381,
	author = {Li, Yumei and Guo, Qinghua and Wan, Bo and Qin, Hongnan and Wang, Dezhi and Xu, Kexin and Song, Shilin and Sun, Qianhui and Zhao, Xiaoxia and Yang, Mohan and Wu, Xiaoyong and Wei, Dengjie and Hu, Tianyu and Su, Yanjun},
	title = {Current status and prospect of three-dimensional dynamic monitoring of natural resources based on LiDAR; [基于激光雷达的自然资源三维动态监测现状与展望]},
	year = {2021},
	journal = {National Remote Sensing Bulletin},
	volume = {25},
