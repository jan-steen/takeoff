	title = {Prediction of the spatial and temporal distribution pattern of Anemone rivularis based on samples collected in a source region of the Yellow River using UAV; [基于无人机采集样本预测黄河源区小花草玉梅的时空分布]},
	year = {2024},
	journal = {Pratacultural Science},
	volume = {41},
	number = {2},
	pages = {308 – 321},
