@ARTICLE{Evans20161411,
	author = {Evans, Ian Scott and Miki, Jessica and Ho, Jessee and Robinson, Derek T.},
	title = {Benchmarking stereo-derived DSMs to lidar by land cover and slope for resource development in northern Ontario, Canada},
