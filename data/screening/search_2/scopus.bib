@ARTICLE{Herrmann2022437,
	author = {Herrmann, Pamela Boelter and Nascimento, Victor Fernandez and De Freitas, Marcos Wellausen Dias},
	title = {Fire Analysis in Grasslands using Remote Sensing: A Systematic Review; [Sensoriamento Remoto Aplicado a Analise de Fogo em Formacoes Campestres: Uma Re-visao Sistematica]},
