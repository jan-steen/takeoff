@ARTICLE{Lu2018205,
	author = {Lu, Bing and He, Yuhong},
	title = {Optimal spatial resolution of Unmanned Aerial Vehicle (UAV)-acquired imagery for species classification in a heterogeneous grassland ecosystem},
	year = {2018},
	journal = {GIScience and Remote Sensing},
	volume = {55},
