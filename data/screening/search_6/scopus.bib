@ARTICLE{Mansour2015,
	author = {Mansour, L.M. and Abbas, K.},
	title = {Typology of feeding strategies for dairy cattle in the semi-arid region of Setif; [Typologie des stratégies d’alimentation des bovins laitiers dans la région semi-aride de Sétif]},
