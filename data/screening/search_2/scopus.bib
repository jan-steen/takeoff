}

@ARTICLE{Vagapova20241080,
	author = {Vagapova, Aina and Mukaeva, Luiza and Gadzhiev, Nadir},
	title = {GREENHOUSE GAS ANALYSIS AT THE CARBON TEST SITE OF THE CHECHEN REPUBLIC: MONITORING METHODS AND RESULTS},
