   Stroner, Martin/P-5835-2014
   Bartak, Vojtech/P-2535-2016
   Klapste, Petr/C-5348-2019
   },
ORCID-Numbers = {Moudra, Lucie/0000-0002-4656-6259
   Moudry, Vitezslav/0000-0002-3194-451X
