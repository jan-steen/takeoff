@ARTICLE{Li2025178,
	author = {Li, Hongxia and Shi, Yun and Shen, Aihong and Ma, Yiting and Liang, Yongliang and Li, Xiaojuan and Dong, Jun and Zhao, Na and She, Jie and Wang, Tong and Zhang, Fenghong and Guo, Rui},
	title = {RESEARCH ON THE CLASSIFICATION OF MICRO-TERRAIN IN THE ALLUVIAL FAN OF HELAN MOUNTAINS EAST FOOT BASED ON RANDOM FOREST ALGORITHM},
	year = {2025},
	journal = {Quaternary Sciences},
	volume = {45},
