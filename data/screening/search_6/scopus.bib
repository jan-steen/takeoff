@ARTICLE{Liu202087,
	author = {Liu, Shu and Zhu, Hang},
	title = {Object-oriented land use classification based on ultra-high resolution images taken by unmanned aerial vehicle; [基于超高空间分辩率无人机影像的面向对象土地利用分类方法]},
	year = {2020},
	journal = {Nongye Gongcheng Xuebao/Transactions of the Chinese Society of Agricultural Engineering},
	volume = {36},
