	keywords = {Antenna grounds; Anthropogenic; Birds; Tropics; Vegetation; Aerial vehicle; Field experiment; Ground measurements; Long-term socio-ecological research; Multi-scale approaches; NDVI; Scale effects; Sequoium; Socio-ecological; Unmanned aerial vehicle; Unmanned aerial vehicles (UAV)},
