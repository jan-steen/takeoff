@ARTICLE{Maire20221743,
	author = {Maire, Juliette and Gibson-Poole, Simon and Cowan, Nicholas and Krol, Dominika and Somers, Cathal and Reay, Dave S. and Skiba, Ute and Rees, Robert M. and Lanigan, Gary J. and Richards, Karl G.},
	title = {Can nitrogen input mapping from aerial imagery improve nitrous oxide emissions estimates from grazed grassland?},
	year = {2022},
