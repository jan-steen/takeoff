}

@ARTICLE{Jia2023,
	author = {Jia, Xiang and Huang, Tiecheng and Chen, Mengyu and Han, Ning and Liu, Yihao and Chen, Shujiang and Zhang, Xiaoli},
	title = {Distribution of Grazing Paths and Their Influence on Mountain Vegetation in the Traditional Grazing Area of the Tien-Shan Mountains},
	year = {2023},
	journal = {Remote Sensing},
	volume = {15},
	number = {12},
	doi = {10.3390/rs15123163},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85164114481&doi=10.3390%2frs15123163&partnerID=40&md5=026bdda3d3f49d3d013fa4fb8d64686c},
	abstract = {In the Tien-Shan Mountains, Ili Prefecture, Xinjiang, China, the livestock industry has experienced rapid growth in recent decades. However, this expansion has led to increased overgrazing behavior, resulting in the proliferation of grazing paths and a decline in vegetation cover. These factors are considered the main causes of vegetation degradation in the region. To investigate this issue, we conducted a study utilizing unmanned aerial vehicle imagery in the Zollersay Mountains of Ili to examine the distribution of grazing paths and their effects on mountain vegetation, including grassland and Malus sieversii. The results of our study revealed that grazing paths in the area exhibited various formations, including parallel, oblique intersection, and grid. On the hilltop, the grazing paths were not only shorter but also wider, whereas on the hillside, they were denser, indicating a higher concentration of livestock trampling events. It was found that grazing path density played a pivotal role in grassland degradation, with a negative correlation observed between grazing path density and indicators such as the grassland quality index and grass vegetation coverage. As grazing path density increased, the damage inflicted on Malus sieversii by livestock also intensified. However, as the trees grow older, their height surpasses the feeding range of livestock, resulting in reduced grazing impact. The findings of our study carry significant implications for developing scientifically informed livestock policies and promoting the conservation of wild fruit forests. © 2023 by the authors.},
	author_keywords = {grazing path; Malus sieversii; quality of grassland; Tien-Shan Mountains},
	keywords = {Antennas; Forestry; Landforms; Grazing areas; Grazing path; Malus sieversii; Path density; Quality of grassland; Rapid growth; Tien-shan mountain; Vegetation cover; Vegetation degradation; Xinjiang; Vegetation},
