	author = {Lussem, Ulrike and Bolten, Andreas and Menne, Jannis and Gnyp, Martin Leon and Schellberg, Jürgen and Bareth, Georg},
	title = {Estimating biomass in temperate grassland with high resolution canopy surface models from UAV-based RGB images and vegetation indices},
	year = {2019},
	journal = {Journal of Applied Remote Sensing},
