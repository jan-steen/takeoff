address={Estonian Univ Life Sci, Inst Agr & Environm Sci, Kreutzwaldi 5, EE-51006 Tartu, Estonia and Univ Eastern Finland, Dept Geog & Hist Studies, POB 111, Joensuu 80101, Finland and Queen Mary Univ London, Sch Geog, London E1 4NS, England},
year={2025},
title={Integrating UAV and Landsat data: A two-scale approach to topsoil moisture mapping in coastal wetlands},
source={ECOLOGICAL INFORMATICS},
