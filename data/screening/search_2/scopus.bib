@ARTICLE{Tay20181139,
	author = {Tay, Jessica Y. L. and Erfmeier, Alexandra and Kalwij, Jesse M.},
	title = {Reaching new heights: can drones replace current methods to study plant population dynamics?},
	year = {2018},
	journal = {Plant Ecology},
	volume = {219},
