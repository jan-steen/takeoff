year={2025},
title={The search for small intrusions of the Stepnyak gold-bearing type within the Akmola region of Kazakhstan: A multi-geophysical technique and unmanned aerial vehicle approach},
source={PHYSICS AND CHEMISTRY OF THE EARTH},
