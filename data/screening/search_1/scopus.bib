	author = {Nuhlíčková, Soňa and Svetlík, Ján and Šibíková, Mária and Jarolímek, Ivan and Zuna-Kratky, Thomas},
	title = {Current distribution, microhabitat requirements and vulnerability of the Keeled Plump Bush-cricket (Isophya costata) at the north-western periphery of its range},
	year = {2021},
	journal = {Journal of Insect Conservation},
	volume = {25},
