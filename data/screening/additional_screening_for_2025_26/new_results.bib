year={2025},
title={Dynamics of carbon stock and normalized difference vegetation index as indicators of oil palm (Elaeis guineensis Jacq.) productivity in peat ecosystem with compound NPK fertilizer application},
source={JOURNAL OF ECOLOGICAL ENGINEERING},
