@ARTICLE{Eames20211,
	author = {Eames, Tom and Russell-Smith, Jeremy and Yates, Cameron and Edwards, Andrew and Vernooij, Roland and Ribeiro, Natasha and Steinbruch, Franziska and van der Werf, Guido R.},
	title = {Instantaneous pre-fire biomass and fuel load measurements from multi-spectral UAS mapping in southern African Savannas},
	year = {2021},
