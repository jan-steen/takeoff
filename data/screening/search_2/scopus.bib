@ARTICLE{Sangjan2022,
	author = {Sangjan, Worasit and Carpenter-Boggs, Lynne A. and Hudson, Tipton D. and Sankaran, Sindhuja},
	title = {Pasture Productivity Assessment under Mob Grazing and Fertility Management Using Satellite and UAS Imagery},
	year = {2022},
	journal = {Drones},
