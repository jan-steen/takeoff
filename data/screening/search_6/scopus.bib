}@ARTICLE{Kanecka-Geszke2021256,
	author = {Kanecka-Geszke, Ewa and Bąk, Bogdan and Bolewski, Tymoteusz and Kaca, Edmund},
	title = {Concept and implementation of the Polish innovative agro-hydro-meteorological monitoring (AgHMM) in INOMEL Project},
