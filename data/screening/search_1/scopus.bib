	title = {Aboveground biomass analysis of an alpine meadow based on unmanned aerial vehicle hyperspectral images in the Haibei pilot area; [基于 UAV 成像高光谱图像的高寒草甸地上生物量——以海北试验区为例]},
	year = {2022},
