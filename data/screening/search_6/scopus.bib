}

@ARTICLE{Sousa2019,
	author = {Sousa, Ana I. and da Silva, José Figueiredo and Azevedo, Ana and Lillebø, Ana I.},
	title = {Blue Carbon stock in Zostera noltei meadows at Ria de Aveiro coastal lagoon (Portugal) over a decade},
	year = {2019},
	journal = {Scientific Reports},
