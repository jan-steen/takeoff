	source = {Scopus},
	note = {Cited by: 2; All Open Access, Gold Open Access}
}

@ARTICLE{Yoshitoshi202435,
	author = {Yoshitoshi, Rena and Sakanoue, Seiichi and Watanabe, Nariyasu},
	title = {Detecting reed canary grass (Phalaris arundinacea L.) patches from UAV-based digital surface model images—A case study in a timothy (Phleum pretense L.) meadow field},
	year = {2024},
	journal = {Grassland Science},
