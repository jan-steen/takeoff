@ARTICLE{Amitrano2023,
	author = {Amitrano, Donato and Cicala, Luca and De Mizio, Marco and Tufano, Francesco},
	title = {UAV Hyperspectral Characterization of Vegetation Using Entropy-Based Active Sampling for Partial Least Square Regression Models},
	year = {2023},
	journal = {Applied Sciences (Switzerland)},
