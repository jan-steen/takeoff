@ARTICLE{Valente2022,
	author = {Valente, João and Hiremath, Santosh and Ariza-Sentís, Mar and Doldersum, Marty and Kooistra, Lammert},
	title = {Mapping of Rumex obtusifolius in nature conservation areas using very high resolution UAV imagery and deep learning},
	year = {2022},
