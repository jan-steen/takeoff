	author = {Bakker, Maarten and Lane, Stuart N.},
	title = {Archival photogrammetric analysis of river–floodplain systems using Structure from Motion (SfM) methods},
	year = {2017},
	journal = {Earth Surface Processes and Landforms},
	volume = {42},
