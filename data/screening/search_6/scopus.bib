@ARTICLE{Qu20241558,
	author = {Qu, Zhi-Qiang and Sun, Xuc-Yan and Yang, Zi-Qiong and Wang, Yu and Bai, Lu and Li, Zhi-Guo and Na, Ya and Han, Guo-Dong and Zhang, Zi-Ting and Wang, Jing},
	title = {Effects of Different Grazing Intensities on the Characteristics of Micro-patch of Desert Grassland Meadows; [不同放牧强度对荒漠草原草地微斑块特征的影响]},
	year = {2024},
	journal = {Acta Agrestia Sinica},
	volume = {32},
