}

@ARTICLE{Tu20215789,
	author = {Tu, Mingguang and Lu, Hong and Shang, Min},
	title = {Monitoring grassland desertification in zoige county using landsat and uav image},
	year = {2021},
	journal = {Polish Journal of Environmental Studies},
	volume = {30},
	number = {6},
	pages = {5789 – 5799},
