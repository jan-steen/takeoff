@ARTICLE{Zhu202361,
	author = {Zhu, Changxin and Zhao, Weixia and Shan, Zhijie and Li, Jiusheng},
	title = {Determination of UAV altitude and take-off time in the design of a variable rate irrigation prescription map; [变量灌溉处方图设计中无人机飞行高度和起飞时间确定]},
