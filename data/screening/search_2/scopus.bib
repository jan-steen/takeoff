@ARTICLE{Pi2021,
	author = {Pi, Weiqiang and Du, Jianmin and Bi, Yuge and Gao, Xinchao and Zhu, Xiangbing},
	title = {3D-CNN based UAV hyperspectral imagery for grassland degradation indicator ground object classification research},
	year = {2021},
