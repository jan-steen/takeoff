@ARTICLE{Bossoukpe2021199,
	author = {Bossoukpe, Marina and Ndiaye, Ousmane and Diatta, Ousmane and Diatta, Sékouna and Audebert, Alain and Couteron, Pierre and Leroux, Louise and Diouf, Abdoul Aziz and Dendoncker, Morgane and Faye, Emile and Taugourdeau, Simon},
	title = {Unmanned aerial vehicle for the assessment of woody and herbaceous phytomass in Sahelian savanna; [Un drone pour l’évaluation de la phytomasse ligneuse et herbacée des savanes sahéliennes]; [Un dron para la evaluación de la fitomasa leñosa y herbácea de las sabanas sahelianas]},
	year = {2021},
	journal = {Revue d'Elevage et de Medecine Veterinaire des Pays Tropicaux(France)},
	volume = {74},
