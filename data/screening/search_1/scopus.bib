@ARTICLE{Rodríguez-Lozano20233115,
	author = {Rodríguez-Lozano, Borja and Rodríguez-Caballero, Emilio and Martínez-Sánchez, Juan F. and Giménez-Luque, Esther and Cantón, Yolanda},
	title = {Lithology modulates the response of water limited Mediterranean ecosystems to aridification},
	year = {2023},
	journal = {Landscape Ecology},
	volume = {38},
