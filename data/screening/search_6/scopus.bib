@ARTICLE{Wang2023,
	author = {Wang, Wenxin and Liu-Zeng, Jing and Shao, Yanxiu and Wang, Zijun and Han, Longfei and Shen, Xuwen and Qin, Kexin and Gao, Yunpeng and Yao, Wenqian and Hu, Guiming and Zeng, Xianyang and Liu, Xiaoli and Wang, Wei and Cui, Fengzhen and Liu, Zhijun and Li, Jinyang and Tu, Hongwei},
	title = {Mapping of Soil Liquefaction Associated with the 2021 Mw 7.4 Maduo (Madoi) Earthquake Based on the UAV Photogrammetry Technology},
	year = {2023},
	journal = {Remote Sensing},
	volume = {15},
