}

@ARTICLE{Higgisson20211312,
	author = {Higgisson, William and Cobb, Adrian and Tschierschke, Alica and Dyer, Fiona},
	title = {Estimating the cover of Phragmites australis using unmanned aerial vehicles and neural networks in a semi-arid wetland},
	year = {2021},
	journal = {River Research and Applications},
	volume = {37},
	number = {9},
	pages = {1312 – 1322},
	doi = {10.1002/rra.3832},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85109029575&doi=10.1002%2frra.3832&partnerID=40&md5=8dd7453a5d4f6c976916782ccc8f805e},
	abstract = {Unmanned aerial vehicles (UAVs) provide high-spatial-resolution imagery and allow the collection of data in locations or periods of time where field-based data collection is challenging or impossible, such as in wetlands and floodplains. Computational deep learning techniques are transforming the way in which remotely sensed imagery and data can be used and are having an increasing role in remote sensing. Here, we describe a method using UAV and machine learning technique convolutional neural networks (CNNs) to estimate the cover of wetland features Phragmites australis reeds, leaf litter, water, bareground, and other vegetation in a large inland floodplain wetland in Western New South Wales (NSW), Australia. We firstly describe the process we took to train, validate, and test the model. We describe the model's performance by calculating a range of performance indicators and provide density maps and results from individual sites. The model had an overall accuracy of 0.947 and recognized and estimated Phragmites australis reeds to a very high accuracy (>98%). Here, we show an effective, accurate, and reproducible way to estimate the cover of Phragmites australis reeds and other wetland features using UAV and CNNs in a semi-arid wetland. © 2021 John Wiley & Sons Ltd.},
	author_keywords = {condition assessment; drones; machine learning; neural networks; reedbeds; wetland monitoring},
	keywords = {Australia; New South Wales; Phragmites australis; aircraft; artificial neural network; assessment method; grass; monitoring; reedbed; semiarid region; unmanned vehicle; wetland},
