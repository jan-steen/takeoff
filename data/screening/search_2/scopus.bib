	title = {Machine Learning Models Based on UAV Oblique Images Improved Above-Ground Biomass Estimation Accuracy Across Diverse Grasslands on the Qinghai–Tibetan Plateau},
	year = {2025},
	journal = {Land Degradation and Development},
