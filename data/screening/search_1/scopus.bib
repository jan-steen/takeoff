@ARTICLE{Lohnherr202320,
	author = {Lohnherr, Judith and Bockwinkel, Günter and Kopp, Marianne},
	title = {The use of drones to monitor success – the example of the restored Lippe in Paderborn-Sande; [Der Einsatz von Drohnen zur Erfolgskontrolle Das Beispiel der renaturierten Lippe in Paderborn-Sande]},
