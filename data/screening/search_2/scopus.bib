@ARTICLE{Wu20232236,
	author = {Wu, Rui-Zhuo and Zhang, Xing-Long and Xu, Xin and Zhang, Chang-Xin},
	title = {Learning predictive tracking control method with Gaussian process modeling for mobile robots; [基于高斯过程建模的移动机器人学习预测控制方法]},
	year = {2023},
	journal = {Kongzhi Lilun Yu Yingyong/Control Theory and Applications},
	volume = {40},
