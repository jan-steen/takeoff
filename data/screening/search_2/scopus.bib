	title = {Quantitative chemical assay of nanogram-level particulate matter using aerosol mass spectrometry: characterization of particles collected from uncrewed atmospheric measurement platforms},
	year = {2023},
	journal = {Atmospheric Measurement Techniques},
	volume = {16},
