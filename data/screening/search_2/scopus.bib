@ARTICLE{Fritsch2021,
	author = {Fritsch, Camille J. and Hanekom, Cathariné and Downs, Colleen T.},
	title = {Hippopotamus population trends in Ndumo Game Reserve, South Africa, from 1951 to 2021},
	year = {2021},
	journal = {Global Ecology and Conservation},
	volume = {32},
