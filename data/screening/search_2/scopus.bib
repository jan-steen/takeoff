@ARTICLE{Abdulai2022567,
	author = {Abdulai, Gabriel A. and Sama, Michael P. and Jackson, Joshua J.},
	title = {EVALUATING TWO LOW-COST GPS RECEIVERS FOR ACCURACY AND EVENTUAL USE IN PASTURED CATTLE RESEARCH},
	year = {2022},
	journal = {Journal of the ASABE},
	volume = {65},
	number = {3},
	pages = {567 – 572},
	doi = {10.13031/ja.14518},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85131240134&doi=10.13031%2fja.14518&partnerID=40&md5=4968a0556697ca2948a957b0ec6d1179},
	abstract = {Using animal-borne global positioning system (GPS) collars, cattle behavioral response to anthropogenic disturbances can be accurately quantified at fine scale. However, the use of dedicated commercial GPS collars in large herd studies is cost-prohibitive. Therefore, low-cost GPS receiver alternatives were evaluated in static placements to determine how their accuracy compares to published data for commercial animal-borne GPS collars. The static accuracies of identical low-cost stand-alone GPS receivers and smartphones were evaluated in an open field without obstructions, under trees with and without canopy, and near an electric fence at 5 min and 1 s sample intervals. The mean circular error probable (CEP) value of the stand-alone GPS receiver was ≤2 m at 5 min and at 1 s in open field placement. The mean CEP value of the stand-alone GPS receiver was ≤3 m at 5 min and at 1 s when placed near the electric fence. The smartphone produced mean CEP values of ≤4 m at 5 min and ≤3 m at 1 s for the fence line and open field placements. Static testing under trees with canopy at the 5 min sample interval produced mean CEP values 100% greater than under trees without canopy at the 1 s sample interval. Low-cost commercial GPS receivers and smartphones with horizontal accuracy of ≤5 m at high sample resolution may offer accurate means of quantifying the behavioral response of cattle to UAVs in large herd studies. © 2022 American Society of Agricultural and Biological Engineers.},
	author_keywords = {Cattle behavior; Global positioning system; Horizontal accuracy; Smartphone GPS; Stand-alone GPS receiver; UAV; Unmanned aerial vehicle},
	keywords = {Animals; Antennas; Behavioral research; Costs; Electric fences; Forestry; Global positioning system; Unmanned aerial vehicles (UAV); Cattle behavior; Circular error probable; Global positioning system receivers; Horizontal accuracy; Low-costs; Sample intervals; Smart phones; Smartphone global positioning system; Stand -alone; Stand-alone global positioning system receiver; accuracy assessment; behavioral response; cattle; GPS; pasture; unmanned vehicle; Smartphones},
	type = {Article},
	publication_stage = {Final},
