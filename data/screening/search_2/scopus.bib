	title = {High-resolution classification of south patagonian peat bog microforms reveals potential gaps in up-scaled CH4 fluxes by use of Unmanned Aerial System (UAS) and CIR imagery},
	year = {2016},
	journal = {Remote Sensing},
	volume = {8},
