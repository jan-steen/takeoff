@ARTICLE{Supramongkonset2021,
	author = {Supramongkonset, Jatuporn and Duangsuwan, Sarun and Maw, Myo Myint and Promwong, Sathaporn},
	title = {Empirical Path Loss Channel Characterization Based on Air-to-Air Ground Reflection Channel Modeling for UAV-Enabled Wireless Communications},
	year = {2021},
	journal = {Wireless Communications and Mobile Computing},
