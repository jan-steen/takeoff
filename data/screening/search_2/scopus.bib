}

@ARTICLE{Perrone2024,
	author = {Perrone, Michela and Conti, Luisa and Galland, Thomas and Komárek, Jan and Lagner, Ondřej and Torresani, Michele and Rossi, Christian and Carmona, Carlos P. and de Bello, Francesco and Rocchini, Duccio and Moudrý, Vítězslav and Šímová, Petra and Bagella, Simonetta and Malavasi, Marco},
	title = {“Flower power”: How flowering affects spectral diversity metrics and their relationship with plant diversity},
	year = {2024},
	journal = {Ecological Informatics},
	volume = {81},
	doi = {10.1016/j.ecoinf.2024.102589},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85189919892&doi=10.1016%2fj.ecoinf.2024.102589&partnerID=40&md5=79b89d6ab44d29c9d00ac7406b42d3a7},
	abstract = {Biodiversity monitoring is constrained by cost- and labour-intensive field sampling methods. Increasing evidence suggests that remotely sensed spectral diversity (SD) is linked to plant diversity, holding promise for monitoring applications. However, studies testing such a relationship reported conflicting findings, especially in challenging ecosystems such as grasslands, due to their variety and high temporal dynamism. It follows that a thorough investigation of the key factors influencing these relationships, such as the metrics applied (i.e., continuous, categorical) and phenology (e.g., flowering), is necessary. The present study aims to assess the effect of flowering on the applicability of six different SD metrics for plant diversity monitoring at the local scale and to investigate how spatial resolution affects the results. Taxonomic diversity was calculated based on data collected in 159 plots of 1.5 m × 1.5 m with experimental mesic grassland communities. Spectral information was collected using a UAV-borne sensor measuring reflectance across six bands in the visible and near-infrared range at ∼2 cm spatial resolution. Our results showed that, in the presence of flowering, the relationship between SD and plant diversity is significant and positive only when SD is calculated using categorical metrics. Despite the observed significance, the variance explained by the models was very low, with no evident differences when resampling spectral data to coarser pixel sizes. Such findings suggest that new insights into the possible confounding effects on the SD-plant diversity relationship in grassland communities are needed to use SD for monitoring purposes. © 2024 The Author(s)},
	author_keywords = {Grasslands; Phenology; Remote sensing; Spectral variation hypothesis; UAV},
	keywords = {flowering; grassland; phenology; pixel; remote sensing; sampling; satellite sensor; spatial resolution; species diversity; spectral analysis; spectral reflectance; unmanned vehicle},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 6; All Open Access, Gold Open Access, Green Open Access}
}

@ARTICLE{Romero2024,
	author = {Romero, Kerin F. and Heenkenda, Muditha K.},
	title = {Developing Site-Specific Prescription Maps for Sugarcane Weed Control Using High-Spatial-Resolution Images and Light Detection and Ranging (LiDAR)},
	year = {2024},
	journal = {Land},
	volume = {13},
	number = {11},
	doi = {10.3390/land13111751},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85210274825&doi=10.3390%2fland13111751&partnerID=40&md5=9b8c404a62c273783247d39ddd5f7979},
	abstract = {Sugarcane is a perennial grass species mainly for sugar production and one of the significant crops in Costa Rica, where ideal growing conditions support its cultivation. Weed control is a critical aspect of sugarcane farming, traditionally managed through preventive or corrective mechanical and chemical methods. However, these methods can be time-consuming and costly. This study aimed to develop site-specific, variable rate prescription maps for weed control using remote sensing. High-spatial-resolution images (5 cm) and Light Detection And Ranging (LiDAR) were acquired using a Micasense Rededge-P camera and a DJI L1 sensor mounted on a drone. Precise locations of weeds were collected for calibration and validation. Normalized Difference Vegetation Index derived from multispectral images separated vegetation coverage and soil. A deep learning (DL) algorithm further classified vegetation coverage into sugarcane and weeds. The DL model performed well without overfitting. The classification accuracy was 87% compared to validation samples. The density and average heights of weed patches were extracted from the canopy height model (LiDAR). They were used to derive site-specific prescription maps for weed control. This efficient and precise alternative to traditional methods could optimize weed control, reduce herbicide usage and provide more profitable yield. © 2024 by the authors.},
	author_keywords = {canopy height model; deep learning; LiDAR; Micasense RedEdge-P camera; sugarcane; variable rate application},
	keywords = {crop yield; grass; lidar; perennial plant; spatial resolution; sugar; weed control},
	type = {Article},
	publication_stage = {Final},
