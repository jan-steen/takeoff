	title = {Estimating aboveground biomass of natural grassland based on multispectral images of Unmanned Aerial Vehicles; [无人机多光谱影像的天然草地生物量估算]},
	year = {2018},
	journal = {Yaogan Xuebao/Journal of Remote Sensing},
	volume = {22},
	number = {5},
	pages = {848 – 856},
	doi = {10.11834/jrs.20186388},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85054886523&doi=10.11834%2fjrs.20186388&partnerID=40&md5=6cb310a138e7fcb653310459220ca29c},
	abstract = {The aboveground biomass of grasslands is an important measurement index for grassland ecosystems and an important basis for the optimal use of grassland resources. In addition, identification of aboveground biomass can be used in monitoring the balance between grassland forage supply and livestock demand. To estimate the aboveground biomass of natural grasslands and determine the variation trend rapidly, accurately, and effectively, we selected the natural rangeland in the northern hillside of Tianshan Mountain as a typical study area and analyzed the spatio-temporal change characteristic of its aboveground biomass. With their rapid development, Unmanned Aerial Vehicles (UAVs) have been extensively used in remote sensing because of their convenient operation, lower cost, and shorter revisit cycle compared with satellites. In addition, the lightweight sensors of UAV allow low-altitude remote sensing, which could capture high-spatial, high-spectral resolution images. We conducted a survey of the different grassland types and vegetation varieties in shady and sunny slopes of the rangeland. We used a multi-rotor UAV equipped with Micro-MCA12 Snap to obtain high-resolution multispectral images and collected field survey data. We established a relational model based on the correlation between the aboveground biomass and Vegetation Indexes (VIs) by regression analysis. Results showed poor correlations between the aboveground biomass and VIs, but these correlations improved remarkably after considering the terrain factors. The effectiveness of the VIs varied in different grassland types and vegetation fractions. Accuracy analysis showed large differences in the fitting accuracy of the different slope aspects and small differences in the effectiveness of the same slope aspect. In sum, the highest effectiveness between the Ratio Vegetation Index (RVI) and the aboveground biomass was obtained in the southern and northern slopes, with an estimation precision of more than 75%. The main conclusions are the following. (1) Different grassland types and vegetation fractions led to the poor correlations between the aboveground biomass in the entire area and VIs. (2) The RVI value in sunny slope was higher than that in shady slope, whereas the aboveground biomass in sunny slope was lower than that in shady slope. Grassland degradation resulted from sustained drought and high temperature. (3) This study proved indirectly the relative insensitivity of heavily vegetated areas. Therefore, the findings of this study coincided well with the actual situation. This research provided a reference for the monitoring of grassland ecosystems and reasonable utilization of grassland resources. © 2018, Science Press. All right reserved.},
	author_keywords = {Biomass; Estimation models; Multispectral images; Natural grassland; Shady-slope and sunny-slope; Unmanned Aerial Vehicles (UAV)},
	keywords = {Agriculture; Antennas; Biomass; Ecosystems; Regression analysis; Remote sensing; Spectral resolution; Surveys; Unmanned aerial vehicles (UAV); Estimation models; Grassland degradation; High spectral resolution images; Multispectral images; Natural grassland; Ratio vegetation indices; Shady-slope and sunny-slope; Spatio-temporal changes; Vegetation},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 15; All Open Access, Bronze Open Access}
}

@ARTICLE{Lambert201835,
	author = {Lambert, J.P.T. and Hicks, H.L. and Childs, D.Z. and Freckleton, R.P.},
	title = {Evaluating the potential of Unmanned Aerial Systems for mapping weeds at field scales: a case study with Alopecurus myosuroides},
	year = {2018},
	journal = {Weed Research},
	volume = {58},
	number = {1},
	pages = {35 – 45},
	doi = {10.1111/wre.12275},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85034080737&doi=10.1111%2fwre.12275&partnerID=40&md5=7ee9e393f7509b8200bf5937687b040b},
	abstract = {Mapping weed densities within crops has conventionally been achieved either by detailed ecological monitoring or by field walking, both of which are time-consuming and expensive. Recent advances have resulted in increased interest in using Unmanned Aerial Systems (UAS) to map fields, aiming to reduce labour costs and increase the spatial extent of coverage. However, adoption of this technology ideally requires that mapping can be undertaken automatically and without the need for extensive ground-truthing. This approach has not been validated at large scale using UAS-derived imagery in combination with extensive ground-truth data. We tested the capability of UAS for mapping a grass weed, Alopecurus myosuroides, in wheat crops. We addressed two questions: (i) can imagery accurately measure densities of weeds within fields and (ii) can aerial imagery of a field be used to estimate the densities of weeds based on statistical models developed in other locations? We recorded aerial imagery from 26 fields using a UAS. Images were generated using both RGB and Rmod (Rmod 670–750 nm) spectral bands. Ground-truth data on weed densities were collected simultaneously with the aerial imagery. We combined these data to produce statistical models that (i) correlated ground-truth weed densities with image intensity and (ii) forecast weed densities in other fields. We show that weed densities correlated with image intensity, particularly Rmod image data. However, results were mixed in terms of out of sample prediction from field-to-field. We highlight the difficulties with transferring models and we discuss the challenges for automated weed mapping using UAS technology. © 2017 The Authors Weed Research published by John Wiley & Sons Ltd on behalf of European Weed Research Society},
	author_keywords = {black-grass; distribution; drones; modelling; precision agriculture; site-specific weed management; wheat},
	keywords = {Alopecurus myosuroides; Triticum aestivum; aerial survey; field method; grass; imagery; mapping method; precision agriculture; spatial distribution; technology adoption; unmanned vehicle; weed; weed control; wheat},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 42; All Open Access, Green Open Access, Hybrid Gold Open Access}
}

@ARTICLE{Forsmoo20182587,
	author = {Forsmoo, Joel and Anderson, Karen and Macleod, Christopher J. A. and Wilkinson, Mark E. and Brazier, Richard},
	title = {Drone-based structure-from-motion photogrammetry captures grassland sward height variability},
	year = {2018},
	journal = {Journal of Applied Ecology},
	volume = {55},
	number = {6},
	pages = {2587 – 2599},
	doi = {10.1111/1365-2664.13148},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85045754058&doi=10.1111%2f1365-2664.13148&partnerID=40&md5=d7953da8e45a70c46dd1679ac005f657},
	abstract = {Grasslands deliver a range of ecosystem services, including the provision of food and biodiversity, and regulation of soil carbon storage and hydrology. Monitoring schemes are needed to quantify spatial changes in these multiple functions alongside ecosystem degradation. Sward height is widely recognised as a key spatial variable in the provision of these services. Current manual monitoring approaches are labour intensive, and often fail to capture spatial patterns of important features, including sward height. Proximal sensing from small aerial drones carrying lightweight cameras can be transformed into surface height models using image-based structure-from-motion and Multi-View Stereo-based approaches; this presents a new opportunity for monitoring the spatial structure of grassland sward height. We combined aerial photographs with field survey data and an open-source image-based modelling-processing workflow to generate sward height measurements for a field comprising mainly Lolium perenne (perennial ryegrass) and Trifolium pratense (red clover). We compared the derived measurements with in situ data captured on the same day using traditional agronomic sward height techniques to determine the quality of the drone-derived surface model product for sward characterisation. The SfM and Multi-View Stereo-based surface model had a mean absolute sward height measurement error of between 3.7 and 4.2 cm. To produce field observations with equivalent quality would require up to 550 sward height measurements for the study site (area: 8,059 m2), which is not feasible over larger extents required for conservation of key species or agronomic purposes. Synthesis and applications. We demonstrate how the collection of precise and detailed information on the spatial structure of grasslands can be made over management-relevant extents. Aerial digital photographs can be transformed into surface models using an image-based modelling approach: structure-from-motion and Multi-View Stereo techniques. Image-based measurements of sward heights were compared with manual sward height data captured on the same day. This novel source of vegetation spatial information could improve sward management for conservation and agronomy applications. The approach supports frequent surveys, at user-controlled revisit times, and delivers data for spatial monitoring of key grassland functions and services. © 2018 The Authors. Journal of Applied Ecology © 2018 British Ecological Society},
	author_keywords = {agronomy; drones; ecosystem service; farming; grassland conservation management; structure-from-motion photogrammetry; sward height; unmanned aerial vehicles},
	keywords = {Lolium perenne; Trifolium pratense; agronomy; biomonitoring; conservation management; data interpretation; farming system; grass; grassland; height determination; herb; imaging method; photogrammetry; remotely operated vehicle; stereo image; sward},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 45; All Open Access, Green Open Access}
}

@ARTICLE{Sun20181703,
	author = {Sun, Bingyu and Jia, Xiufang and Huang, He and Wei, Yuanyuan and Zhou, Linli and Fang, Wei and Yan, Shu},
	title = {Decision-making and management system based on internet of things for Hulun Buir State Farm; [基于物联网的草牧业管理决策系统在呼伦贝尔农垦的应用]},
	year = {2018},
	journal = {Kexue Tongbao/Chinese Science Bulletin},
	volume = {63},
	number = {17},
	pages = {1703 – 1710},
	doi = {10.1360/N972017-01156},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85076387166&doi=10.1360%2fN972017-01156&partnerID=40&md5=aa039a8b7ebb894490a1caf59d8b1525},
	abstract = {According to the specific requirements of scientific decision-making and precision production control in the production process of modern grasslands and animal husbandry, this paper presents a scheme of production command decision system of modern grasslands and animal husbandry based on internet of things. The scheme is composed of four major components, including big data and cloud computing, grassland animal husbandry production management decision information system, precision operating technology and equipment systems, e-commerce and full traceability system. Specific description is as follows: (ⅰ) Big data and cloud computing. According to the large-scale and high-value characteristics of big data, theoretical method and technical system of big data acquisition, management and services of grass and animal husbandry are perfectly established. Large data center hardware platform is constructed based on cloud computing technology. PB(Petabyte) level grassland animal husbandry data resources are integrated and large data intelligent services are carried out based on agricultural vertical search engine, agricultural cloud data management, agricultural knowledge ontology and other key technologies. (ⅱ) Grassland animal husbandry production management decision information system. According to the organizational structure and production management model of Hulun Buir State Farm, the agricultural production management and decision information system of Hulun Buir is developed in accordance with the concept of "horizontal to the side, vertical to the end", that is, horizontal to edge refers to the data information that can be obtained from each group, sub-bureau, farm user and the production team user; vertical to bottom refers to the latest information that can be obtained from every field crop, every farm machine, and every cow. A data warehouse is built, including comparing current accumulated temperature data and rainfall data with over years. The monitoring data of soil, including soil moisture and temperature, conductivity and salt, provide accurate soil parameters for the grass and animal husbandry, and the installation of video surveillance points timely access to soil information. (ⅲ) Precision operating technology and equipment systems. Based on herbage yield information, satellite and unmanned aerial vehicle remote sensing data and measured data of farmland soil nutrients, the spatial variability information of farmland fertility is obtained, and the fertilizer prescription map is formulated. In the process of operation, the GPS data are acquired in real time and the data of fertilizer prescription maps are read, and the accurate fertilization operation is realized through the variable fertilization control system and the equipment. (ⅳ) E-commerce and full traceability system. Business electronic platform of grass industry can perfectly provide the business service to the merchants. Each batch of grass and derivatives will be able to ensure quality, quantity, and customer interests through traceability systems in the future, so that production has records, flows can be traced and responsibility can be defined. By content of decision system, low level of production mode, low degree of intelligent and fine control and lack of market information guidance of production platform are solved in large and medium-sized grass pasture in China, in order to enhance the level of modern grass animal husbandry information and help modern grass production and transformation of the production mode. © 2018, Science Press. All right reserved.},
	author_keywords = {Big data; Decision-making; Grasslands and animal husbandry; Informatization; Intelligent},
	keywords = {Animals; Antennas; Big data; Cloud computing; Crops; Data acquisition; Data warehouses; Decision making; Decision support systems; Electronic commerce; Farms; Fertilizers; Global positioning system; Human resource management; Information systems; Information use; Internet of things; Network security; Process control; Production control; Remote sensing; Search engines; Security systems; Soil moisture; Agricultural production management; Animal husbandry; Cloud computing technologies; Decision information system; Informatization; Intelligent; Organizational structures; Technology and equipments; Information management},
	type = {Article},
	publication_stage = {Final},
