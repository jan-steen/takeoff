@ARTICLE{Pergent-Martini2022,
	author = {Pergent-Martini, Christine and Monnier, Briac and Lehmann, Léa and Barralon, Emeline and Pergent, Gérard},
	title = {Major regression of Posidonia oceanica meadows in relation with recreational boat anchoring: A case study from Sant'Amanza bay},
	year = {2022},
	journal = {Journal of Sea Research},
	volume = {188},
