	keywords = {Ecology; Ecosystems; Landforms; Methane; Microforms; Peat; Unmanned aerial vehicles (UAV); Wetlands; Classification approach; Closed chambers; High resolution; Kappa index of agreements; Object based image analysis; Peatland; RPAS; Unmanned aerial systems; Uncertainty analysis},
