@ARTICLE{Lange202297,
	author = {Lange, Troels and Oncken, Nele S. and Svane, Niels and Steinfurth, Rune C. and Kristensen, Erik and Flindt, Mogens R.},
	title = {Large-scale eelgrass transplantation: a measure for carbon and nutrient sequestration in estuaries},
	year = {2022},
	journal = {Marine Ecology Progress Series},
	volume = {685},
	pages = {97 – 109},
	doi = {10.3354/meps13975},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85127480736&doi=10.3354%2fmeps13975&partnerID=40&md5=0ea20ebdf1facc75d21b06bbfc724239},
	abstract = {The accelerated global losses of seagrass meadows makes restoration increasingly important. This restoration study was conducted in a shallow Danish estuary and describes one of the rare examples of successful large-scale eelgrass Zostera marina restoration outside North America. A simplified 3-step site selection approach was successfully applied to locate an optimal site for large-scale transplantation. It consisted of (1) qualitative assessments of vegetation using aerial photos, (2) inspection of potential sites with assessments of stressor presence and potential growth conditions and (3) transplantation tests for a final assessment of site suitability and methodology. The large-scale transplantation was initiated at the test site with the highest shoot production. After transplantation, shoot densities developed rapidly, achieving a 70-fold increase in density after about 2 yr. A rapid edge expansion (0.32 m yr-1) of the transplanted area was detected using drone-based monitoring. Both the final shoot density and edge expansion were comparable to those of natural eelgrass patches in the estuary. Eelgrass-transplanted areas accumulated more fine sediment particles and organic C, N and P than adjacent unvegetated sediment. Burial of organic C, N and P in eelgrass-transplanted sediments was 33 ± 7.5, 6.6 ± 0.9 and 3.0 ± 0.5 g m-2 yr-1, respectively (mean ± SE). In addition, inorganic C and N were assimilated by eelgrass transplants at rates of 290 ± 22 and 12 ± 1.0 g m-2 yr-1, respectively. The results highlight that important ecosystem services are already restored 2 yr after successful eelgrass restoration. © 2022 Inter-Research. All rights reserved.},
	author_keywords = {Carbon burial; Drone; Nitrogen burial; Restoration; Seagrass; Zostera marina},
