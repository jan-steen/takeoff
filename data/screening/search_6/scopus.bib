	source = {Scopus},
	note = {Cited by: 24; All Open Access, Gold Open Access}
}

@ARTICLE{Getzin2021399,
	author = {Getzin, Stephan and Erickson, Todd E. and Yizhaq, Hezi and Muñoz-Rojas, Miriam and Huth, Andreas and Wiegand, Kerstin},
	title = {Bridging ecology and physics: Australian fairy circles regenerate following model assumptions on ecohydrological feedbacks},
	year = {2021},
	journal = {Journal of Ecology},
	volume = {109},
